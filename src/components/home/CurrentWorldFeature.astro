---
import type { LocalizedText, World } from '../../types/world';
import { localize, localizedAltAttributes, localizedTextAttributes } from '../../utils/localization';

interface Props {
	world: World;
}

const { world } = Astro.props;
const text = (en: string, es: string): LocalizedText => ({ en, es });
const content = {
	label: text('The inner logic', 'La lógica interior'),
	title: text('Different Worlds, One Inner Evolution', 'Mundos Diferentes, Una Sola Evolución Interior'),
	body: text(
		'Fhugawz is not held together by genre, but by psychological continuity. The thirteen worlds unfold through thirteen psychological states that shape the sequence of the albums and their transformation. As those inner conditions shift, the sound, imagery and narrative language shift with them.',
		'Fhugawz no está unido por el género, sino por la continuidad psicológica. Los trece mundos se despliegan a través de trece estados psicológicos que dan forma a la secuencia de los álbumes y a su transformación. A medida que cambian esas condiciones interiores, también cambian el sonido, las imágenes y el lenguaje narrativo.'
	),
	supporting: text(
		'Autobiography, fiction, surrealism and transcendence can therefore coexist within the same body of work: each world gives form to a different moment in that inner evolution.',
		'La autobiografía, la ficción, el surrealismo y la trascendencia pueden por tanto coexistir dentro de una misma obra: cada mundo da forma a un momento diferente de esa evolución interior.'
	),
	conclusion: text(
		'Each shift in style is tied to a shift in inner state.',
		'Cada cambio de estilo está ligado a un cambio en el estado interior.'
	),
	leftAnchor: text('three inner movements / thirteen worlds', 'tres movimientos interiores / trece mundos'),
	rightAnchor: text('one narrative / multiple states of becoming', 'una narrativa / múltiples estados del devenir'),
};
---

<section class="inner-logic" aria-labelledby="inner-logic-title">
	<img
		class="inner-logic-background"
		src={world.artwork.hero}
		alt={localize(world.artwork.alt, 'en')}
		{...localizedAltAttributes(world.artwork.alt)}
		loading="lazy"
		decoding="async"
	/>
	<div class="inner-logic-grade" aria-hidden="true"></div>

	<div class="inner-logic-frame">
		<div class="inner-logic-rail" aria-hidden="true"><span></span><i></i></div>

		<div class="inner-logic-left">
			<div class="inner-logic-copy">
				<p class="inner-logic-label" {...localizedTextAttributes(content.label)}>{localize(content.label, 'en')}</p>
				<h2 id="inner-logic-title" {...localizedTextAttributes(content.title)}>{localize(content.title, 'en')}</h2>
				<div class="inner-logic-rule" aria-hidden="true"></div>
				<p class="inner-logic-body" {...localizedTextAttributes(content.body)}>{localize(content.body, 'en')}</p>
				<p class="inner-logic-supporting" {...localizedTextAttributes(content.supporting)}>{localize(content.supporting, 'en')}</p>
			</div>
			<p class="inner-logic-conclusion" {...localizedTextAttributes(content.conclusion)}>{localize(content.conclusion, 'en')}</p>
		</div>

		<div class="inner-gallery" data-inner-logic-gallery aria-hidden="true">
			<div class="inner-gallery__main" data-gallery-slot="main">
				<img class="inner-gallery__layer" src="/media/home/inner-logic/fhugawz-inner-logic-set-01-main.webp" alt="" loading="lazy" decoding="async" />
			</div>
			<div class="inner-gallery__thumb inner-gallery__thumb--1" data-gallery-slot="detail-01">
				<img class="inner-gallery__layer" src="/media/home/inner-logic/fhugawz-inner-logic-set-01-detail-01.webp" alt="" loading="lazy" decoding="async" />
			</div>
			<div class="inner-gallery__thumb inner-gallery__thumb--2" data-gallery-slot="detail-02">
				<img class="inner-gallery__layer" src="/media/home/inner-logic/fhugawz-inner-logic-set-01-detail-02.webp" alt="" loading="lazy" decoding="async" />
			</div>
			<div class="inner-gallery__thumb inner-gallery__thumb--3" data-gallery-slot="detail-03">
				<img class="inner-gallery__layer" src="/media/home/inner-logic/fhugawz-inner-logic-set-01-detail-03.webp" alt="" loading="lazy" decoding="async" />
			</div>
		</div>

		<div class="inner-logic-anchors">
			<p {...localizedTextAttributes(content.leftAnchor)}>{localize(content.leftAnchor, 'en')}</p>
			<p {...localizedTextAttributes(content.rightAnchor)}>{localize(content.rightAnchor, 'en')}</p>
		</div>
	</div>
</section>

<style>
	.inner-logic {
		position: relative;
		min-height: min(900px, 100svh);
		overflow: hidden;
		background: #070807;
		color: #f1ede4;
		isolation: isolate;
	}

	.inner-logic-background,
	.inner-logic-grade {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.inner-logic-background {
		z-index: -3;
		object-fit: cover;
		object-position: 52% center;
		filter: saturate(.58) contrast(1.08) brightness(.62);
		transform: scale(1.015);
		transition: transform 1.1s cubic-bezier(.22, 1, .36, 1), filter 1.1s ease;
	}

	.inner-logic-grade {
		z-index: -2;
		background:
			linear-gradient(90deg, rgba(5, 7, 8, .94) 0%, rgba(5, 7, 8, .8) 42%, rgba(5, 7, 8, .48) 68%, rgba(5, 7, 8, .72) 100%),
			linear-gradient(180deg, rgba(5, 7, 8, .74) 0%, rgba(5, 7, 8, .14) 48%, rgba(5, 7, 8, .94) 100%);
	}

	.inner-logic:hover .inner-logic-background {
		filter: saturate(.62) contrast(1.08) brightness(.65);
		transform: scale(1.025);
	}

	.inner-logic-frame {
		position: relative;
		display: grid;
		width: min(1160px, calc(100% - 40px));
		min-height: min(900px, 100svh);
		grid-template-columns: minmax(0, 1.08fr) minmax(360px, .92fr);
		grid-template-rows: auto 1fr auto;
		gap: 40px clamp(48px, 6vw, 82px);
		align-items: center;
		margin: 0 auto;
		padding: clamp(72px, 8vw, 108px) 0 clamp(42px, 5vw, 64px);
	}

	.inner-logic-rail {
		position: absolute;
		top: clamp(62px, 8vw, 102px);
		right: 0;
		left: 0;
		display: flex;
		align-items: center;
		gap: 13px;
		pointer-events: none;
	}

	.inner-logic-rail::after {
		flex: 1;
		height: 1px;
		content: '';
		background: linear-gradient(90deg, rgba(241, 237, 228, .28), rgba(241, 237, 228, .04));
	}

	.inner-logic-rail span {
		width: 4px;
		height: 4px;
		background: rgba(255, 90, 31, .82);
		transform: rotate(45deg);
	}

	.inner-logic-rail i {
		width: 34px;
		height: 1px;
		background: rgba(241, 237, 228, .28);
	}

	.inner-logic-left {
		grid-column: 1;
		grid-row: 2;
		align-self: center;
		max-width: 680px;
	}

	.inner-logic-copy {
		max-width: 680px;
	}

	.inner-logic-label {
		margin: 0;
		color: rgba(241, 237, 228, .58);
		font-size: .72rem;
		font-weight: 500;
		letter-spacing: .08em;
		text-transform: uppercase;
	}

	.inner-logic h2 {
		max-width: 660px;
		margin: 24px 0 0;
		color: #f1ede4;
		font-family: var(--font-sans);
		font-size: clamp(2.5rem, 4.2vw, 4rem);
		font-weight: 450;
		letter-spacing: -.035em;
		line-height: 1.04;
		text-wrap: balance;
		text-transform: none;
	}

	.inner-logic-rule {
		width: min(180px, 32vw);
		height: 1px;
		margin: clamp(38px, 5vw, 54px) 0 28px;
		background: linear-gradient(90deg, rgba(241, 237, 228, .3), transparent);
	}

	.inner-logic-body {
		max-width: 640px;
		margin: 0;
		color: rgba(241, 237, 228, .72);
		font-size: clamp(1rem, 1.22vw, 1.125rem);
		line-height: 1.7;
		text-wrap: pretty;
	}

	.inner-logic-supporting {
		max-width: 640px;
		margin: 24px 0 0;
		color: rgba(241, 237, 228, .62);
		font-size: clamp(1rem, 1.22vw, 1.125rem);
		line-height: 1.7;
		text-wrap: pretty;
	}

	.inner-logic-conclusion {
		position: relative;
		max-width: 520px;
		margin: 30px 0 0;
		padding-left: 18px;
		color: rgba(241, 237, 228, .88);
		font-size: .88rem;
		font-weight: 500;
		letter-spacing: .015em;
		line-height: 1.6;
	}

	.inner-logic-conclusion::before {
		position: absolute;
		top: .28em;
		bottom: .28em;
		left: 0;
		width: 1px;
		content: '';
		background: rgba(255, 90, 31, .78);
	}

	.inner-gallery {
		--gallery-gap: 12px;
		--thumb-size: clamp(150px, 11vw, 190px);
		--gallery-height: calc(var(--thumb-size) + var(--thumb-size) + var(--thumb-size) + var(--gallery-gap) + var(--gallery-gap));
		display: grid;
		grid-column: 2;
		grid-row: 2;
		width: min(100%, 560px);
		height: var(--gallery-height);
		grid-template-columns: minmax(0, 1fr) var(--thumb-size);
		grid-template-rows: repeat(3, var(--thumb-size));
		gap: var(--gallery-gap);
		align-items: stretch;
		justify-self: end;
		align-self: center;
		min-width: 0;
		min-height: 0;
		overflow: hidden;
	}

	.inner-gallery__main,
	.inner-gallery__thumb {
		position: relative;
		min-width: 0;
		min-height: 0;
		overflow: hidden;
		contain: layout paint;
		isolation: isolate;
	}

	.inner-gallery__main {
		grid-column: 1;
		grid-row: 1 / 4;
	}

	.inner-gallery__thumb--1 {
		grid-column: 2;
		grid-row: 1;
	}

	.inner-gallery__thumb--2 {
		grid-column: 2;
		grid-row: 2;
	}

	.inner-gallery__thumb--3 {
		grid-column: 2;
		grid-row: 3;
	}

	:global(.inner-gallery__layer) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
		object-position: center;
		filter: saturate(.56) contrast(1.1) brightness(.72) blur(0);
		opacity: 1;
		transform: scale(1);
		will-change: opacity, transform, filter;
	}

	:global(.inner-gallery__layer--incoming) {
		z-index: 2;
		opacity: 0;
		filter: saturate(.56) contrast(1.1) brightness(.72) blur(4px);
		transform: scale(1.03);
		transition: opacity 1.1s cubic-bezier(.22, 1, .36, 1), transform 1.1s cubic-bezier(.22, 1, .36, 1), filter 1.1s cubic-bezier(.22, 1, .36, 1);
	}

	:global(.inner-gallery__layer--incoming.is-active) {
		opacity: 1;
		filter: saturate(.56) contrast(1.1) brightness(.72) blur(0);
		transform: scale(1);
	}

	:global(.inner-gallery__layer--outgoing) {
		z-index: 1;
		opacity: 0;
		filter: saturate(.56) contrast(1.1) brightness(.72) blur(4px);
		transform: scale(1.01);
		transition: opacity 1.05s cubic-bezier(.22, 1, .36, 1), transform 1.05s cubic-bezier(.22, 1, .36, 1), filter 1.05s cubic-bezier(.22, 1, .36, 1);
	}

	.inner-logic-anchors {
		display: flex;
		grid-column: 1 / -1;
		grid-row: 3;
		align-items: center;
		justify-content: space-between;
		gap: 32px;
		padding-top: 18px;
		border-top: 1px solid rgba(241, 237, 228, .13);
	}

	.inner-logic-anchors p {
		margin: 0;
		color: rgba(241, 237, 228, .38);
		font-size: .63rem;
		letter-spacing: .07em;
		line-height: 1.5;
	}

	.inner-logic-anchors p:last-child { text-align: right; }

	@media (max-width: 860px) {
		.inner-logic-frame {
			grid-template-columns: minmax(0, 1fr) minmax(300px, .85fr);
			gap: 36px;
		}

	}

	@media (max-width: 700px) {
		.inner-logic { min-height: 0; }
		.inner-logic-background { object-position: 55% center; }
		.inner-logic-grade {
			background:
				linear-gradient(180deg, rgba(5, 7, 8, .9), rgba(5, 7, 8, .62) 42%, rgba(5, 7, 8, .94)),
				linear-gradient(90deg, rgba(5, 7, 8, .8), rgba(5, 7, 8, .36));
		}

		.inner-logic-frame {
			width: min(100% - 40px, 560px);
			min-height: 0;
			grid-template-columns: 1fr;
			grid-template-rows: auto;
			gap: 42px;
			padding: 78px 0 54px;
		}

		.inner-logic-rail { top: 76px; }
		.inner-logic-left {
			display: contents;
		}

		.inner-logic-copy {
			grid-column: 1;
			grid-row: auto;
			order: 1;
			padding-top: 32px;
		}

		.inner-logic h2 {
			max-width: 520px;
			font-size: clamp(2.25rem, 11vw, 3.2rem);
			line-height: 1.04;
		}

		.inner-logic-body { line-height: 1.68; }
		.inner-logic-supporting { line-height: 1.68; }
		.inner-gallery {
			grid-column: 1;
			grid-row: auto;
			width: min(100%, 480px);
			justify-self: center;
			order: 2;
		}

		.inner-logic-conclusion {
			grid-column: 1;
			grid-row: auto;
			order: 3;
		}

		.inner-logic-anchors {
			grid-column: 1;
			grid-row: auto;
			align-items: flex-start;
			order: 4;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.inner-logic-background { transition: none; }
		.inner-logic:hover .inner-logic-background { transform: scale(1.015); }
		:global(.inner-gallery__layer) { transition: none; }
	}
</style>

<script>
	const gallery = document.querySelector<HTMLElement>('[data-inner-logic-gallery]');
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	const gallerySets = Array.from({ length: 6 }, (_, setIndex) => {
		const set = String(setIndex + 1).padStart(2, '0');
		return [
			`/media/home/inner-logic/fhugawz-inner-logic-set-${set}-main.webp`,
			`/media/home/inner-logic/fhugawz-inner-logic-set-${set}-detail-01.webp`,
			`/media/home/inner-logic/fhugawz-inner-logic-set-${set}-detail-02.webp`,
			`/media/home/inner-logic/fhugawz-inner-logic-set-${set}-detail-03.webp`,
		];
	});

	if (gallery) {
		const slots = Array.from(gallery.querySelectorAll<HTMLElement>('[data-gallery-slot]'));
		const pendingTimers = new Set<number>();
		let currentSet = 0;

		const clearTimers = () => {
			pendingTimers.forEach((timer) => window.clearTimeout(timer));
			pendingTimers.clear();
		};

		const after = (callback: () => void, delay: number) => {
			const timer = window.setTimeout(() => {
				pendingTimers.delete(timer);
				callback();
			}, delay);
			pendingTimers.add(timer);
		};

		const preloadSet = (setIndex: number) => Promise.all(
			gallerySets[setIndex].map((source) => new Promise<void>((resolve) => {
				const image = new Image();
				image.onload = image.onerror = () => resolve();
				image.src = source;
			}))
		);

		const showFirstSet = () => {
			currentSet = 0;
			slots.forEach((slot, slotIndex) => {
				const image = document.createElement('img');
				image.className = 'inner-gallery__layer';
				image.src = gallerySets[0][slotIndex];
				image.alt = '';
				image.loading = 'lazy';
				image.decoding = 'async';
				slot.replaceChildren(image);
			});
		};

		const swapSlot = (slotIndex: number, source: string) => {
			const slot = slots[slotIndex];
			const outgoing = slot.querySelector<HTMLImageElement>(':scope > .inner-gallery__layer:last-child');
			if (!outgoing) return;

			const incoming = document.createElement('img');
			incoming.src = source;
			incoming.alt = '';
			incoming.loading = 'lazy';
			incoming.decoding = 'async';
			incoming.className = 'inner-gallery__layer inner-gallery__layer--incoming';
			slot.append(incoming);

			requestAnimationFrame(() => requestAnimationFrame(() => {
				outgoing.classList.add('inner-gallery__layer--outgoing');
				incoming.classList.add('is-active');
			}));

			after(() => {
				outgoing.remove();
				incoming.classList.remove('inner-gallery__layer--incoming', 'is-active');
			}, 1150);
		};

		const scheduleNextSet = () => {
			if (reducedMotion.matches) return;
			after(async () => {
				const nextSet = (currentSet + 1) % gallerySets.length;
				await preloadSet(nextSet);
				if (reducedMotion.matches) return;

				[0, 170, 390, 620].forEach((delay, slotIndex) => {
					after(() => swapSlot(slotIndex, gallerySets[nextSet][slotIndex]), delay);
				});

				after(() => {
					currentSet = nextSet;
					void preloadSet((currentSet + 1) % gallerySets.length);
					scheduleNextSet();
				}, 1800);
			}, 6000);
		};

		const updateMotionPreference = () => {
			clearTimers();
			if (reducedMotion.matches) {
				showFirstSet();
				return;
			}
			void preloadSet((currentSet + 1) % gallerySets.length);
			scheduleNextSet();
		};

		updateMotionPreference();
		reducedMotion.addEventListener('change', updateMotionPreference);
	}
</script>
