---
import type { World } from '../../types/world';
import { artistUi, worldStageLabels } from '../../data/artist-ui';
import { localize, localizedAltAttributes, localizedTextAttributes } from '../../utils/localization';

interface Props {
	world: World;
}

const { world } = Astro.props;
const stageLabel = worldStageLabels[world.stage];
---

<article class="world-card">
	<a class="world-card-link" href={`/worlds/${world.slug}`}>
		<div class="world-card-media">
			<img
				src={world.artwork.card}
				alt={localize(world.artwork.alt, 'en')}
				{...localizedAltAttributes(world.artwork.alt)}
				loading="lazy"
				decoding="async"
			/>
			<span class="world-card-number" aria-hidden="true">{world.displayNumber}</span>
		</div>
		<div class="world-card-body">
			<div class="world-card-meta">
				<span {...localizedTextAttributes(artistUi.sections.world)}>{localize(artistUi.sections.world, 'en')}</span>
				<span aria-hidden="true">/</span>
				<span {...localizedTextAttributes(stageLabel)}>{localize(stageLabel, 'en')}</span>
			</div>
			<h2>{world.title}</h2>
			<p class="world-card-genre" {...localizedTextAttributes(world.genre)}>{localize(world.genre, 'en')}</p>
			<p class="world-card-summary" {...localizedTextAttributes(world.summary)}>{localize(world.summary, 'en')}</p>
			<span class="world-card-action" {...localizedTextAttributes(artistUi.navigation.exploreWorld)}>
				{localize(artistUi.navigation.exploreWorld, 'en')}
			</span>
		</div>
	</a>
</article>

<style>
	.world-card {
		min-width: 0;
		border: 1px solid var(--line);
		background: rgba(13, 16, 13, 0.48);
	}

	.world-card-link {
		display: grid;
		height: 100%;
		grid-template-rows: auto 1fr;
	}

	.world-card-media {
		position: relative;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border-bottom: 1px solid var(--line);
	}

	.world-card-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}

	.world-card-link:hover .world-card-media img,
	.world-card-link:focus-visible .world-card-media img {
		transform: scale(1.025);
	}

	.world-card-link:focus-visible {
		outline: 2px solid var(--signal-orange);
		outline-offset: 4px;
	}

	.world-card-number {
		position: absolute;
		right: 14px;
		bottom: 10px;
		color: var(--paper);
		font-family: var(--font-display);
		font-size: clamp(2.3rem, 6vw, 4.6rem);
		font-weight: 900;
		line-height: 0.85;
		text-shadow: 0 3px 18px rgba(0, 0, 0, 0.7);
	}

	.world-card-body {
		display: flex;
		min-width: 0;
		flex-direction: column;
		padding: 24px;
	}

	.world-card-meta,
	.world-card-genre,
	.world-card-action {
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.world-card-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 7px;
		color: var(--signal-orange);
	}

	h2 {
		margin: 14px 0 7px;
		font-family: var(--font-display);
		font-size: clamp(2rem, 4vw, 3.2rem);
		line-height: 0.95;
		text-transform: uppercase;
	}

	.world-card-genre {
		margin: 0;
		color: rgba(223, 211, 187, 0.62);
	}

	.world-card-summary {
		margin: 18px 0 24px;
		color: rgba(223, 211, 187, 0.78);
		line-height: 1.65;
	}

	.world-card-action {
		margin-top: auto;
		color: var(--bone);
		text-decoration: underline;
		text-decoration-color: var(--signal-orange);
		text-underline-offset: 5px;
	}
</style>
