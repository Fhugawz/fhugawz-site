---
import type { World } from '../../types/world';
import { artistUi } from '../../data/artist-ui';
import { getWorldArchiveCover } from '../../data/world-archive-covers';
import { localize, localizedAltAttributes, localizedAriaAttributes, localizedTextAttributes } from '../../utils/localization';
import DotWavePlayer from '../DotWavePlayer.astro';
import WorldAlbumCta from './WorldAlbumCta.astro';

interface Props {
	worlds: World[];
}

const { worlds } = Astro.props;
---

<dialog
	id="world-archive-dialog"
	class="world-detail-dialog"
	data-world-dialog
	aria-modal="true"
>
	<div class="world-detail-shell">
		<button
			class="world-detail-close"
			type="button"
			data-world-close
			aria-label={artistUi.worldsPage.close.en}
			{...localizedAriaAttributes(artistUi.worldsPage.close)}
		>
			<span {...localizedTextAttributes(artistUi.worldsPage.close)}>{localize(artistUi.worldsPage.close, 'en')}</span>
			<span aria-hidden="true">×</span>
		</button>

		{worlds.map((world, index) => {
			const previewTracks = world.tracks.filter((track) => track.preview);
			const cover = getWorldArchiveCover(world.slug, world.artwork.hero);
			const narrativeParagraphs = world.narrative.en.split('\n\n');
			return (
				<article class="world-detail-panel" data-world-panel={index} hidden={index !== 0}>
					<figure class="world-detail-visual">
						<img src={cover} alt={localize(world.artwork.alt, 'en')} {...localizedAltAttributes(world.artwork.alt)} loading="lazy" decoding="async" />
						<div aria-hidden="true"></div>
					</figure>

					<div class="world-detail-copy">
						<div class="world-detail-meta">
							<span>{world.displayNumber} / 13</span>
							<span {...localizedTextAttributes(world.genre)}>{localize(world.genre, 'en')}</span>
						</div>
						<h2 id={`world-detail-title-${index}`}>{world.title}</h2>
						<div class="world-detail-title-action">
							<WorldAlbumCta href={world.sunoAlbumUrl} variant="overlay" />
						</div>
						<div class="world-detail-narrative" id={`world-detail-description-${index}`}>
							{narrativeParagraphs.map((paragraph) => <p>{paragraph}</p>)}
						</div>

						<div class="world-detail-previews">
							{previewTracks.map((track) => track.preview && (
								<div class="world-detail-preview">
									<strong>{track.title}</strong>
									<DotWavePlayer
										id={`archive-${track.id}`}
										title={`${world.title} — ${track.title}`}
										audioSrc={track.preview.src}
										playLabel={artistUi.player.play.en}
										playLabelEs={artistUi.player.play.es}
										pauseLabel={artistUi.player.pause.en}
										pauseLabelEs={artistUi.player.pause.es}
										visualizerLabel={artistUi.player.visualizer.en}
										visualizerLabelEs={artistUi.player.visualizer.es}
										visualization="line"
									/>
								</div>
							))}
						</div>

						<nav class="world-detail-navigation" aria-label={artistUi.worldsPage.overlayNavigation.en} {...localizedAriaAttributes(artistUi.worldsPage.overlayNavigation)}>
							<button type="button" data-world-previous>
								<span aria-hidden="true">←</span>
								<span {...localizedTextAttributes(artistUi.worldsPage.previous)}>{localize(artistUi.worldsPage.previous, 'en')}</span>
							</button>
							<button type="button" data-world-next>
								<span {...localizedTextAttributes(artistUi.worldsPage.next)}>{localize(artistUi.worldsPage.next, 'en')}</span>
								<span aria-hidden="true">→</span>
							</button>
						</nav>
					</div>
				</article>
			);
		})}
	</div>
</dialog>

<script>
	const worldDialog = document.querySelector('[data-world-dialog]');
	if (worldDialog instanceof HTMLDialogElement) {
		const panels = Array.from(worldDialog.querySelectorAll('[data-world-panel]'));
		const openers = Array.from(document.querySelectorAll('[data-world-open]'));
		const closeControl = worldDialog.querySelector('[data-world-close]');
		let activeIndex = 0;
		let returnFocus = null;

		const activateWorld = (requestedIndex) => {
			const total = panels.length;
			if (!total) return;
			activeIndex = (requestedIndex + total) % total;
			panels.forEach((panel, index) => {
				if (panel instanceof HTMLElement) panel.hidden = index !== activeIndex;
			});
			worldDialog.setAttribute('aria-labelledby', `world-detail-title-${activeIndex}`);
			worldDialog.setAttribute('aria-describedby', `world-detail-description-${activeIndex}`);
			window.dispatchEvent(new CustomEvent('fhugawz:pause-players', { detail: 'world-overlay-change' }));
			window.requestAnimationFrame(() => window.dispatchEvent(new Event('resize')));
		};

		const openWorld = (index, trigger) => {
			returnFocus = trigger;
			activateWorld(index);
			if (!worldDialog.open) worldDialog.showModal();
			document.documentElement.classList.add('world-overlay-open');
			if (closeControl instanceof HTMLElement) closeControl.focus();
		};

		openers.forEach((opener) => opener.addEventListener('click', () => {
			const index = Number(opener.getAttribute('data-world-open'));
			if (Number.isInteger(index)) openWorld(index, opener);
		}));

		closeControl?.addEventListener('click', () => worldDialog.close());
		worldDialog.querySelectorAll('[data-world-previous]').forEach((control) => control.addEventListener('click', () => activateWorld(activeIndex - 1)));
		worldDialog.querySelectorAll('[data-world-next]').forEach((control) => control.addEventListener('click', () => activateWorld(activeIndex + 1)));
		worldDialog.addEventListener('click', (event) => {
			if (event.target === worldDialog) worldDialog.close();
		});
		worldDialog.addEventListener('close', () => {
			document.documentElement.classList.remove('world-overlay-open');
			window.dispatchEvent(new CustomEvent('fhugawz:pause-players', { detail: 'world-overlay-close' }));
			if (returnFocus instanceof HTMLElement && returnFocus.isConnected) returnFocus.focus();
			returnFocus = null;
		});
	}
</script>

<style>
	:global(html.world-overlay-open){overflow:hidden}
	.world-detail-dialog{width:min(1440px,calc(100vw - 40px));height:min(900px,calc(100dvh - 40px));max-width:none;max-height:none;margin:auto;border:0;padding:0;background:#090b0c;color:#f1ede4;overflow:hidden}
	.world-detail-dialog::backdrop{background:rgba(2,3,4,.82);backdrop-filter:blur(8px)}
	.world-detail-shell{position:relative;height:100%;overflow:auto;overscroll-behavior:contain}
	.world-detail-close{position:absolute;top:18px;right:20px;z-index:4;display:flex;gap:12px;align-items:center;border:0;padding:10px;background:rgba(7,9,10,.48);color:rgba(241,237,228,.72);cursor:pointer;font-size:.62rem;letter-spacing:.08em}
	.world-detail-close span:last-child{font-size:1.2rem;font-weight:300;line-height:.7}
	.world-detail-close:hover,.world-detail-close:focus-visible{color:#f1ede4}
	.world-detail-close:focus-visible{outline:1px solid rgba(255,90,31,.9);outline-offset:3px}
	.world-detail-panel{display:grid;min-height:100%;grid-template-columns:minmax(360px,.92fr) minmax(420px,1.08fr)}
	.world-detail-panel[hidden]{display:none}
	.world-detail-visual{position:relative;display:grid;min-height:100%;place-items:center;margin:0;overflow:hidden;background:transparent}
	.world-detail-visual img{position:relative;z-index:1;width:100%;height:auto;aspect-ratio:1/1;object-fit:contain;filter:saturate(.68) contrast(1.06) brightness(.78)}
	.world-detail-visual div{position:absolute;z-index:2;inset:0;width:100%;height:100%;pointer-events:none}
	.world-detail-visual div{background:linear-gradient(90deg,transparent 60%,rgba(9,11,12,.32)),linear-gradient(180deg,transparent 55%,rgba(7,9,10,.45))}
	.world-detail-copy{display:flex;min-width:0;flex-direction:column;padding:clamp(72px,8vw,118px) clamp(38px,6vw,92px) clamp(34px,5vw,68px)}
	.world-detail-meta{display:flex;flex-wrap:wrap;gap:9px 20px;color:rgba(241,237,228,.5);font-size:.62rem;font-weight:550;letter-spacing:.07em;line-height:1.4}
	.world-detail-meta span:first-child{color:rgba(255,90,31,.84)}
	.world-detail-copy h2{max-width:720px;margin:clamp(24px,3vw,38px) 0 0;font-family:var(--font-sans);font-size:clamp(3rem,5.2vw,5.75rem);font-weight:430;letter-spacing:-.05em;line-height:.96;text-wrap:balance;text-transform:none}
	.world-detail-title-action{margin-top:14px}
	.world-detail-narrative{max-width:680px;margin:clamp(28px,3.5vw,46px) 0 0;color:rgba(241,237,228,.66);font-size:clamp(.98rem,1.2vw,1.12rem);line-height:1.72;text-wrap:pretty}
	.world-detail-narrative p{margin:0}
	.world-detail-narrative p+p{margin-top:1.25em}
	.world-detail-previews{margin-top:clamp(34px,4vw,52px);padding-top:22px;border-top:1px solid rgba(255,90,31,.3);background:linear-gradient(180deg,rgba(255,90,31,.035),transparent 88px)}
	.world-detail-preview + .world-detail-preview{margin-top:14px}
	.world-detail-preview strong{color:var(--signal-orange);font-family:var(--font-sans);font-size:1rem;font-weight:480;text-shadow:0 0 12px rgba(255,90,31,.12)}
	.world-detail-preview :global(.dot-player){margin-top:12px}
	.world-detail-preview :global(.player-button){width:38px;height:38px}
	.world-detail-preview :global(.dot-wave){height:52px}
	.world-detail-navigation{display:flex;gap:28px;justify-content:space-between;margin-top:auto;padding-top:clamp(38px,5vw,72px)}
	.world-detail-navigation button{display:flex;gap:12px;align-items:center;border:0;padding:8px 0;background:transparent;color:rgba(241,237,228,.54);cursor:pointer;font-size:.65rem;letter-spacing:.06em;transition:color .3s ease}
	.world-detail-navigation button:hover,.world-detail-navigation button:focus-visible{color:#f1ede4}
	.world-detail-navigation button:focus-visible{outline:1px solid rgba(255,90,31,.9);outline-offset:5px}
	.world-detail-navigation button>span[aria-hidden]{color:rgba(255,90,31,.8);font-size:.9rem}
	@media(max-width:900px){
		.world-detail-dialog{width:calc(100vw - 24px);height:calc(100dvh - 24px)}
		.world-detail-panel{grid-template-columns:minmax(300px,.85fr) minmax(360px,1.15fr)}
		.world-detail-copy{padding-right:34px;padding-left:34px}
	}
	@media(max-width:700px){
		.world-detail-dialog{width:100vw;height:100dvh}
		.world-detail-panel{display:block;min-height:0}
		.world-detail-visual{min-height:0;aspect-ratio:1}
		.world-detail-copy{min-height:calc(100dvh - 100vw);padding:34px 22px 28px}
		.world-detail-copy h2{font-size:clamp(2.75rem,14vw,4.4rem)}
		.world-detail-close{position:fixed;top:12px;right:12px}
		.world-detail-navigation{padding-top:48px}
	}
	@media(prefers-reduced-motion:reduce){
		.world-detail-navigation button{transition:none}
		.world-detail-dialog::backdrop{backdrop-filter:none}
	}
</style>
