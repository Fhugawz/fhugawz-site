---
import type { World } from '../../types/world';
import { artistUi, worldStageLabels } from '../../data/artist-ui';
import { localize, localizedAltAttributes, localizedTextAttributes } from '../../utils/localization';

interface Props {
	world: World;
}

const { world } = Astro.props;
const stageLabel = worldStageLabels[world.stage];
---

<section class="world-hero">
	<div class="site-shell world-hero-grid">
		<div class="world-hero-copy">
			<p class="section-kicker">
				<span {...localizedTextAttributes(artistUi.sections.world)}>{localize(artistUi.sections.world, 'en')}</span>
				<span aria-hidden="true"> {world.displayNumber}</span>
			</p>
			<h1>{world.title}</h1>
			<p class="world-hero-genre" {...localizedTextAttributes(world.genre)}>{localize(world.genre, 'en')}</p>
			<p class="world-hero-summary" {...localizedTextAttributes(world.summary)}>{localize(world.summary, 'en')}</p>
			<div class="world-stage">
				<span {...localizedTextAttributes(artistUi.sections.currentStage)}>{localize(artistUi.sections.currentStage, 'en')}</span>
				<strong {...localizedTextAttributes(stageLabel)}>{localize(stageLabel, 'en')}</strong>
			</div>
		</div>
		<div class="world-hero-media">
			<img
				src={world.artwork.hero}
				alt={localize(world.artwork.alt, 'en')}
				{...localizedAltAttributes(world.artwork.alt)}
				loading="eager"
				decoding="async"
				fetchpriority="high"
			/>
		</div>
	</div>
</section>

<style>
	.world-hero {
		padding: clamp(48px, 7vw, 92px) 0;
		border-bottom: 1px solid var(--line);
	}

	.world-hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(320px, 1.1fr);
		gap: clamp(30px, 6vw, 84px);
		align-items: center;
	}

	.world-hero-copy,
	.world-hero-media {
		min-width: 0;
	}

	h1 {
		margin: 14px 0 12px;
		font-family: var(--font-display);
		font-size: clamp(4rem, 10vw, 8.5rem);
		font-weight: 900;
		letter-spacing: -0.035em;
		line-height: 0.82;
		text-transform: uppercase;
		overflow-wrap: anywhere;
	}

	.world-hero-genre {
		margin: 0;
		color: var(--signal-orange);
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.world-hero-summary {
		max-width: 680px;
		margin: 28px 0;
		color: rgba(223, 211, 187, 0.82);
		font-size: clamp(1.05rem, 1.5vw, 1.25rem);
		line-height: 1.72;
	}

	.world-stage {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 14px;
		align-items: center;
		font-size: 0.75rem;
		letter-spacing: 0.11em;
		text-transform: uppercase;
	}

	.world-stage span {
		color: rgba(223, 211, 187, 0.58);
	}

	.world-stage strong {
		border: 1px solid var(--signal-orange);
		border-radius: 999px;
		color: var(--paper);
		padding: 7px 11px;
	}

	.world-hero-media {
		aspect-ratio: 4 / 3;
		border: 1px solid var(--line);
		overflow: hidden;
	}

	.world-hero-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (max-width: 820px) {
		.world-hero-grid {
			grid-template-columns: 1fr;
		}

		.world-hero-media {
			order: -1;
		}
	}
</style>
