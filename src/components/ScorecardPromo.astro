---
type PromoContext = 'services' | 'resources' | 'contact';

interface Props {
	context: PromoContext;
	image: string;
}

const { context, image } = Astro.props;

const copy = {
	services: {
		en: {
			kicker: 'FREE ARTIST DIAGNOSTIC',
			title: 'NOT SURE WHICH SERVICE YOUR PROJECT NEEDS?',
			body: 'Answer 20 focused questions about identity, sound, visual world, release preparation and content. The Scorecard shows where your project stands, what needs attention and gives Fhugawz Studio a clearer basis for helping you.',
			cta: 'TAKE THE FREE SCORECARD',
			alt: 'Artist planning and creative direction for the Fhugawz Studio Scorecard.',
		},
		es: {
			kicker: 'DIAGNÓSTICO GRATUITO PARA ARTISTAS',
			title: '¿NO TIENES CLARO QUÉ SERVICIO NECESITA TU PROYECTO?',
			body: 'Responde 20 preguntas sobre identidad, sonido, universo visual, preparación de lanzamiento y contenido. El Scorecard te muestra dónde está tu proyecto, qué necesita atención y le da a Fhugawz Studio una base más clara para ayudarte.',
			cta: 'HACER EL SCORECARD GRATUITO',
			alt: 'Planificación artística y dirección creativa para el Scorecard de Fhugawz Studio.',
		},
	},
	resources: {
		en: {
			kicker: 'FREE CREATIVE RESOURCE',
			title: 'START WITH A CLEARER MAP OF YOUR ARTIST PROJECT',
			body: 'Use the Scorecard before spending more time or money. It helps organize scattered ideas, identify weak areas and understand the next practical step for your identity, release and content system.',
			cta: 'START THE FREE DIAGNOSTIC',
			alt: 'Creative resources and visual direction connected to the Fhugawz Artist Scorecard.',
		},
		es: {
			kicker: 'RECURSO CREATIVO GRATUITO',
			title: 'EMPIEZA CON UN MAPA MÁS CLARO DE TU PROYECTO ARTÍSTICO',
			body: 'Usa el Scorecard antes de invertir más tiempo o dinero. Te ayuda a organizar ideas dispersas, detectar áreas débiles y entender el siguiente paso práctico para tu identidad, lanzamiento y sistema de contenido.',
			cta: 'COMENZAR DIAGNÓSTICO GRATUITO',
			alt: 'Recursos creativos y dirección visual conectados al Scorecard artístico de Fhugawz.',
		},
	},
	contact: {
		en: {
			kicker: 'FIND YOUR STARTING POINT',
			title: 'NOT READY TO EXPLAIN THE WHOLE PROJECT YET?',
			body: 'Complete the diagnostic first. You can receive the results by email and send the same context to Fhugawz Studio, so the conversation starts with a clearer picture of your strongest and priority areas.',
			cta: 'COMPLETE THE FREE SCORECARD',
			alt: 'Fhugawz Studio contact and artist project diagnosis.',
		},
		es: {
			kicker: 'ENCUENTRA TU PUNTO DE PARTIDA',
			title: '¿TODAVÍA NO SABES CÓMO EXPLICAR TODO TU PROYECTO?',
			body: 'Completa primero el diagnóstico. Puedes recibir los resultados por correo y enviar el mismo contexto a Fhugawz Studio, para que la conversación comience con una imagen más clara de tus áreas fuertes y prioritarias.',
			cta: 'COMPLETAR SCORECARD GRATUITO',
			alt: 'Contacto de Fhugawz Studio y diagnóstico de proyecto artístico.',
		},
	},
}[context];
---

<section class="scorecard-promo" aria-label="Artist Identity and Release Readiness Scorecard">
	<div class="site-shell scorecard-promo-grid">
		<div class="scorecard-promo-copy scorecard-promo-en">
			<p class="scorecard-promo-kicker">{copy.en.kicker}</p>
			<h2>{copy.en.title}</h2>
			<p>{copy.en.body}</p>
			<div class="scorecard-promo-meta" aria-label="20 questions, 5 areas, 5 to 8 minutes">
				<span>20 QUESTIONS</span><span>5 AREAS</span><span>5–8 MIN</span>
			</div>
			<a class="scorecard-promo-button" href="/scorecard" data-analytics-event="scorecard_promo_click" data-analytics-category="lead" data-analytics-label={context}>{copy.en.cta}</a>
		</div>
		<div class="scorecard-promo-copy scorecard-promo-es">
			<p class="scorecard-promo-kicker">{copy.es.kicker}</p>
			<h2>{copy.es.title}</h2>
			<p>{copy.es.body}</p>
			<div class="scorecard-promo-meta" aria-label="20 preguntas, 5 áreas, 5 a 8 minutos">
				<span>20 PREGUNTAS</span><span>5 ÁREAS</span><span>5–8 MIN</span>
			</div>
			<a class="scorecard-promo-button" href="/scorecard" data-analytics-event="scorecard_promo_click" data-analytics-category="lead" data-analytics-label={context}>{copy.es.cta}</a>
		</div>
		<div class="scorecard-promo-media">
			<img src={image} alt={copy.en.alt} loading="lazy" decoding="async" />
		</div>
	</div>
</section>

<style>
	.scorecard-promo {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		border-block: 1px solid rgba(13, 16, 13, 0.26);
		background:
			linear-gradient(112deg, rgba(255, 90, 31, 0.98), rgba(255, 90, 31, 0.86)),
			url('/images/textures/texture-fhugawz-dark-film-grain.webp');
		background-size: auto, 620px;
		color: var(--ink);
	}

	.scorecard-promo::after {
		position: absolute;
		inset: 0;
		z-index: -1;
		content: '';
		background: linear-gradient(90deg, transparent 0 58%, rgba(13, 16, 13, 0.15));
		pointer-events: none;
	}

	.scorecard-promo-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.72fr);
		gap: clamp(36px, 7vw, 88px);
		align-items: center;
		padding-block: clamp(56px, 7vw, 92px);
	}

	.scorecard-promo-copy { min-width: 0; }
	.scorecard-promo-es { display: none; }
	:global(html[data-language='es']) .scorecard-promo-en { display: none; }
	:global(html[data-language='es']) .scorecard-promo-es { display: block; }

	.scorecard-promo-kicker {
		margin: 0 0 14px;
		font-size: 0.76rem;
		font-weight: 900;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.scorecard-promo h2 {
		margin: 0;
		max-width: 760px;
		font-family: var(--font-display);
		font-size: clamp(2.65rem, 5.5vw, 5.35rem);
		font-weight: 900;
		letter-spacing: -0.02em;
		line-height: 0.92;
		text-transform: uppercase;
		text-wrap: balance;
	}

	.scorecard-promo-copy > p:not(.scorecard-promo-kicker) {
		max-width: 690px;
		margin: 24px 0 0;
		font-size: clamp(1rem, 1.35vw, 1.14rem);
		font-weight: 600;
		line-height: 1.65;
	}

	.scorecard-promo-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 25px;
	}

	.scorecard-promo-meta span {
		border: 1px solid rgba(13, 16, 13, 0.44);
		border-radius: 999px;
		font-size: 0.68rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		padding: 8px 11px;
	}

	.scorecard-promo-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 50px;
		margin-top: 28px;
		border: 1px solid var(--ink);
		background: var(--ink);
		color: var(--bone);
		font-size: 0.8rem;
		font-weight: 900;
		letter-spacing: 0.1em;
		padding: 14px 20px;
		text-transform: uppercase;
		transition: transform 0.2s ease, background 0.2s ease;
	}

	.scorecard-promo-button:hover,
	.scorecard-promo-button:focus-visible {
		background: var(--blackgreen);
		outline: 2px solid var(--ink);
		outline-offset: 4px;
		transform: translateY(-2px);
	}

	.scorecard-promo-media {
		position: relative;
		min-height: clamp(280px, 32vw, 420px);
		border: 1px solid rgba(13, 16, 13, 0.5);
		box-shadow: 18px 18px 0 rgba(13, 16, 13, 0.16);
		overflow: hidden;
	}

	.scorecard-promo-media::after {
		position: absolute;
		inset: 0;
		content: '';
		background: linear-gradient(135deg, rgba(13, 16, 13, 0.04), rgba(13, 16, 13, 0.34));
		pointer-events: none;
	}

	.scorecard-promo-media img {
		width: 100%;
		height: 100%;
		min-height: inherit;
		object-fit: cover;
		filter: contrast(1.08) saturate(0.92);
	}

	@media (max-width: 820px) {
		.scorecard-promo-grid { grid-template-columns: 1fr; }
		.scorecard-promo h2 { font-size: clamp(2.4rem, 10vw, 4.3rem); }
		.scorecard-promo-media { min-height: 280px; order: -1; }
	}

	@media (max-width: 520px) {
		.scorecard-promo-grid { width: min(100% - 28px, 1160px); padding-block: 44px; }
		.scorecard-promo h2 { font-size: clamp(2.2rem, 12vw, 3.4rem); }
		.scorecard-promo-media { min-height: 230px; box-shadow: 10px 10px 0 rgba(13, 16, 13, 0.16); }
		.scorecard-promo-button { width: 100%; }
	}
</style>
