---
import ScorecardPromoDark from './ScorecardPromoDark.astro';
import '../styles/scorecard-promo-refine.css';
type PromoContext = 'services' | 'resources' | 'contact';
interface Props { context: PromoContext; image: string; }
const { context, image } = Astro.props;
---

<ScorecardPromoDark context={context} image={image} />

<style is:global>
	.scorecard-promo-slot .promo {
		background:
			linear-gradient(135deg, rgba(13, 16, 13, 0.96), rgba(23, 28, 22, 0.94)),
			url('/images/textures/texture-fhugawz-dark-film-grain.webp'),
			var(--blackgreen);
		background-size: auto, 620px, auto;
	}

	.scorecard-promo-slot .promo::before {
		display: none;
	}

	.scorecard-promo-slot .promo::after {
		background: linear-gradient(90deg, rgba(13, 16, 13, 0.16), rgba(13, 16, 13, 0.02));
	}

	.scorecard-promo-slot .detail {
		border-color: color-mix(in srgb, var(--signal-orange) 82%, transparent);
		background: var(--signal-orange);
		color: #fff;
		box-shadow: 0 18px 48px rgba(0, 0, 0, 0.24);
	}

	.scorecard-promo-slot .detail p {
		color: #fff;
	}

	.scorecard-promo-slot .detail .meta span {
		border-color: rgba(255, 255, 255, 0.58);
		color: #fff;
	}

	.scorecard-promo-slot .detail a {
		border-color: #fff;
		background: #fff;
		color: var(--ink);
	}

	.scorecard-promo-slot .detail a:hover,
	.scorecard-promo-slot .detail a:focus-visible {
		outline-color: rgba(255, 255, 255, 0.72);
		background: var(--paper);
	}
</style>