---
import ScorecardPromoDark from './ScorecardPromoDark.astro';
type PromoContext='services'|'resources'|'contact';
interface Props{context:PromoContext;image:string;}
const{context,image}=Astro.props;
---
<ScorecardPromoDark context={context} image={image}/>
<style is:global>
.scorecard-promo-slot .promo{background:linear-gradient(135deg,rgba(13,16,13,.96),rgba(23,28,22,.94)),url('/images/textures/texture-fhugawz-dark-film-grain.webp'),var(--blackgreen);background-size:auto,620px,auto}.scorecard-promo-slot .promo::before{display:none}.scorecard-promo-slot .detail{position:relative;overflow:hidden;border-color:rgba(255,255,255,.72);background:url('/images/social/og-fhugawz-cinematic-dark-pop.webp') center/cover no-repeat;color:var(--ink);box-shadow:0 18px 48px rgba(0,0,0,.24);transition:border-color .22s ease,box-shadow .22s ease,transform .22s ease}.scorecard-promo-slot .detail::before{position:absolute;top:0;left:0;width:0;height:3px;content:'';background:#fff;transition:width .28s ease}.scorecard-promo-slot .detail::after{display:none}.scorecard-promo-slot .detail>*{position:relative;z-index:1}.scorecard-promo-slot .detail:hover,.scorecard-promo-slot .detail:focus-within{border-color:#fff;box-shadow:0 18px 48px rgba(0,0,0,.3);transform:translateY(-2px)}.scorecard-promo-slot .detail:hover::before,.scorecard-promo-slot .detail:focus-within::before{width:100%}.scorecard-promo-slot .detail p,.scorecard-promo-slot .detail .detail-copy{color:var(--ink)!important}.scorecard-promo-slot .detail .meta span{border-color:rgba(13,16,13,.54);color:var(--ink)!important;text-transform:uppercase}.scorecard-promo-slot .detail a{border:0!important;outline:0!important;background:#fff;color:var(--ink)}.scorecard-promo-slot .detail a:hover,.scorecard-promo-slot .detail a:focus-visible{border:0!important;outline:0!important;background:#000;color:var(--signal-orange)}
</style>