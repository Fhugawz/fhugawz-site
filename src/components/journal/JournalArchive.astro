---
import type { JournalEntry } from '../../data/journal';
import { artistUi } from '../../data/artist-ui';
import JournalEntryCard from './JournalEntryCard.astro';
import { localize, localizedTextAttributes } from '../../utils/localization';

interface Props {
	page: number;
	totalPages: number;
	featuredEntry?: JournalEntry;
	secondaryEntries: JournalEntry[];
}

const { page, totalPages, featuredEntry, secondaryEntries } = Astro.props;
const pageHref = (targetPage: number) => (targetPage === 1 ? '/journal' : `/journal/${targetPage}`);
const journalHeroNote = {
	primary: { en: 'Process notes', es: 'Notas de proceso' },
	secondary: { en: 'Ongoing archive · behind the work', es: 'Archivo en curso · detrás de la obra' },
};
---

<div class="journal-index">
	<header class="journal-index-hero">
		<img class="journal-index-hero-image" src="/images/journal/fhugawz-journal-creative-process-hero.webp" alt="" aria-hidden="true" fetchpriority="high" />
		<div class="journal-index-hero-grade" aria-hidden="true"></div>
		<div class="site-shell journal-index-hero-copy">
			<div class="journal-index-hero-main">
				<p class="section-kicker" {...localizedTextAttributes(artistUi.journalPage.kicker)}>{localize(artistUi.journalPage.kicker, 'en')}</p>
				<h1 {...localizedTextAttributes(artistUi.journalPage.title)}>{localize(artistUi.journalPage.title, 'en')}</h1>
				<p {...localizedTextAttributes(artistUi.journalPage.description)}>{localize(artistUi.journalPage.description, 'en')}</p>
			</div>
			<div class="journal-index-hero-note">
				<span {...localizedTextAttributes(journalHeroNote.primary)}>{localize(journalHeroNote.primary, 'en')}</span>
				<p {...localizedTextAttributes(journalHeroNote.secondary)}>{localize(journalHeroNote.secondary, 'en')}</p>
			</div>
		</div>
	</header>

	<section class="journal-index-entries" aria-labelledby="journal-entry-list-title">
		<img class="journal-index-entries-image" src="/images/journal/fhugawz-journal-archive-background.webp" alt="" aria-hidden="true" loading="eager" decoding="async" />
		<div class="journal-index-entries-grade" aria-hidden="true"></div>
		<div class="site-shell journal-index-entries-content">
			<h2 class="visually-hidden" id="journal-entry-list-title" {...localizedTextAttributes(artistUi.journalPage.title)}>{localize(artistUi.journalPage.title, 'en')}</h2>
			{featuredEntry && <JournalEntryCard entry={featuredEntry} featured />}
			{secondaryEntries.length > 0 && (
				<div class="journal-secondary-grid">
					{secondaryEntries.map((entry) => <JournalEntryCard entry={entry} />)}
				</div>
			)}
			{totalPages > 1 && (
				<nav class="journal-pagination" aria-label="Journal pagination">
					{page > 1 ? <a href={pageHref(page - 1)}>← <span data-artist-en="Previous" data-artist-es="Anterior">Previous</span></a> : <span aria-hidden="true"></span>}
					<p>{String(page).padStart(2, '0')} / {String(totalPages).padStart(2, '0')}</p>
					{page < totalPages ? <a href={pageHref(page + 1)}><span data-artist-en="Next" data-artist-es="Siguiente">Next</span> →</a> : <span aria-hidden="true"></span>}
				</nav>
			)}
		</div>
	</section>
</div>

<style>
	.journal-index{min-height:100vh;overflow:clip;background:#080a0b;color:#f1ede4}
	.journal-index-hero{position:relative;display:flex;min-height:calc(100svh - 72px);align-items:stretch;overflow:hidden;background:#080a0b}
	.journal-index-hero-image,.journal-index-hero-grade,.journal-index-entries-image,.journal-index-entries-grade{position:absolute;inset:0;width:100%;height:100%}
	.journal-index-hero-image{object-fit:cover;object-position:center 42%;filter:saturate(.54) contrast(1.08) brightness(.68);transform:scale(1.01)}
	.journal-index-hero-grade{background:radial-gradient(circle at 62% 42%,rgba(7,9,10,.1),rgba(7,9,10,.58) 68%),linear-gradient(90deg,rgba(5,7,8,.9) 0%,rgba(5,7,8,.58) 50%,rgba(5,7,8,.22) 100%),linear-gradient(0deg,#080a0b 0%,rgba(8,10,11,.22) 58%,rgba(8,10,11,.5) 100%)}
	.journal-index-hero-copy{position:relative;z-index:1;display:flex;width:min(1160px,calc(100% - 40px));max-width:1160px;min-height:calc(100svh - 72px);flex-direction:column;justify-content:flex-end;padding:clamp(112px,15vh,168px) 0 clamp(56px,8vh,88px)}
	.journal-index-hero-main{width:100%;max-width:560px}
	.journal-index-hero .section-kicker{margin:0;color:#a39f96;font-size:.7rem;font-weight:650;letter-spacing:.14em}
	.journal-index-hero h1{max-width:560px;margin:20px 0 0;font-family:var(--font-sans);font-size:clamp(1.875rem,2.8vw,2.875rem);font-weight:450;letter-spacing:-.025em;line-height:1.12;text-transform:none}
	.journal-index-hero-main>p:last-child{max-width:540px;margin:clamp(26px,4vh,38px) 0 0;color:rgba(241,237,228,.7);font-size:clamp(.94rem,1.05vw,1rem);line-height:1.65;text-wrap:pretty}
	.journal-index-hero-note{position:relative;display:flex;width:100%;gap:28px;align-items:center;justify-content:space-between;margin-top:clamp(30px,4.5vh,44px);padding-top:16px;border-top:1px solid rgba(241,237,228,.2);color:rgba(241,237,228,.46);font-size:.64rem;font-weight:550;letter-spacing:.07em}
	.journal-index-hero-note::after{position:absolute;top:-2px;right:0;width:4px;height:4px;content:'';background:rgba(241,237,228,.88);transform:rotate(45deg)}
	.journal-index-hero-note span{color:rgba(255,90,31,.84)}
	.journal-index-hero-note p{margin:0;padding-right:12px;text-align:right}
	.journal-index-entries{position:relative;isolation:isolate;overflow:hidden;padding:clamp(68px,9vw,128px) 0;background:#080a0b}
	.journal-index-entries-image{z-index:-2;object-fit:cover;object-position:center;filter:brightness(.5) saturate(.55);transform:scale(1.02)}
	.journal-index-entries-grade{z-index:-1;background:linear-gradient(180deg,#080a0b 0%,rgba(8,10,11,.82) 16%,rgba(8,10,11,.7) 84%,#080a0b 100%),linear-gradient(90deg,rgba(8,10,11,.42),rgba(8,10,11,.2))}
	.journal-index-entries-content{position:relative;z-index:1;width:min(1160px,calc(100% - 40px));max-width:1160px}
	.journal-secondary-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(34px,5vw,66px) clamp(20px,2.75vw,38px);margin-top:clamp(54px,7vw,92px)}
	.journal-pagination{display:grid;grid-template-columns:1fr auto 1fr;gap:20px;align-items:center;margin-top:clamp(56px,8vw,100px);padding-top:17px;border-top:1px solid rgba(241,237,228,.18);color:rgba(241,237,228,.68);font-size:.68rem;font-weight:650;letter-spacing:.08em}
	.journal-pagination a{color:inherit;text-decoration:none;transition:color 320ms ease}
	.journal-pagination a:last-child{text-align:right}
	.journal-pagination a:hover,.journal-pagination a:focus-visible{color:var(--signal-orange)}
	.journal-pagination p{margin:0;color:rgba(241,237,228,.5)}
	.visually-hidden{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
	@media(prefers-reduced-motion:reduce){.journal-index-hero-image,.journal-index-entries-image{transform:none}}
	@media(max-width:760px){
		.journal-index-hero{min-height:calc(100svh - 64px)}
		.journal-index-hero-image{object-position:58% center}
		.journal-index-hero-grade{background:linear-gradient(180deg,rgba(7,9,10,.48),rgba(7,9,10,.38) 42%,#080a0b 100%)}
		.journal-index-hero-copy{width:100%;max-width:none;min-height:calc(100svh - 64px);padding:96px clamp(20px,6vw,24px) 42px}
		.journal-index-hero-main{max-width:340px}
		.journal-index-hero .section-kicker{font-size:.64rem;letter-spacing:.12em}
		.journal-index-hero h1{max-width:340px;margin-top:17px;font-size:clamp(1.875rem,8vw,2.25rem)}
		.journal-index-hero-main>p:last-child{max-width:340px;margin-top:24px;font-size:.94rem;line-height:1.62}
		.journal-index-entries{padding:56px 0 64px}
		.journal-index-entries-content{width:min(100% - 40px,1160px)}
		.journal-secondary-grid{grid-template-columns:1fr;gap:40px;margin-top:48px}
	}
	@media(min-width:761px) and (max-width:1024px){.journal-secondary-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
