---
interface Props {
	id: string;
	title: string;
	audioSrc: string;
	playLabel?: string;
	playLabelEs?: string;
	pauseLabel?: string;
	pauseLabelEs?: string;
	visualizerLabel?: string;
	visualizerLabelEs?: string;
	visualization?: 'dots' | 'line';
}

const {
	id,
	title,
	audioSrc,
	playLabel = 'Play preview',
	playLabelEs = 'Reproducir preview',
	pauseLabel = 'Pause preview',
	pauseLabelEs = 'Pausar preview',
	visualizerLabel = 'Audio visualizer for',
	visualizerLabelEs = 'Visualizador de audio para',
	visualization = 'dots',
} = Astro.props;
---

<div
	class="dot-player"
	data-player-id={id}
	data-audio-src={audioSrc}
	data-play-label-en={playLabel}
	data-play-label-es={playLabelEs}
	data-pause-label-en={pauseLabel}
	data-pause-label-es={pauseLabelEs}
	data-visualization={visualization}
>
	<button class="player-button" type="button" aria-label={playLabel} data-play-button>
		<span class="player-icon player-icon-play" aria-hidden="true"></span>
	</button>
	<canvas
		class="dot-wave"
		width="560"
		height="96"
		role="img"
		aria-label={`${visualizerLabel} ${title}`}
		data-artist-aria-en={`${visualizerLabel} ${title}`}
		data-artist-aria-es={`${visualizerLabelEs} ${title}`}
	></canvas>
</div>

<style is:global>
	.dot-player[data-visualization="line"] .player-button {
		border: 1px solid rgba(255, 90, 31, .56);
		background: rgba(255, 90, 31, .1);
		box-shadow: 0 0 14px rgba(255, 90, 31, .1);
		transition: border-color 260ms ease, background-color 260ms ease, box-shadow 260ms ease;
	}

	.dot-player[data-visualization="line"] .player-button:hover,
	.dot-player[data-visualization="line"] .player-button:focus-visible {
		border-color: rgba(255, 90, 31, .84);
		background: rgba(255, 90, 31, .18);
		box-shadow: 0 0 20px rgba(255, 90, 31, .18);
	}

	.dot-player[data-visualization="line"] .player-button:focus-visible {
		outline: 2px solid var(--signal-orange);
		outline-offset: 3px;
	}

	.dot-player[data-visualization="line"] .dot-wave {
		border: 0;
		border-radius: 0;
		background: transparent;
		box-shadow: none;
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.dot-player[data-visualization="line"] .player-button {
			transition: none;
		}
	}
</style>

<script>
	const players = document.querySelectorAll('.dot-player');
	const stopEvent = 'fhugawz:pause-players';
	const playIcon = '<span class="player-icon player-icon-play" aria-hidden="true"></span>';
	const pauseIcon = '<span class="player-icon player-icon-pause" aria-hidden="true"></span>';

	players.forEach((player) => {
		const canvas = player.querySelector('canvas');
		const button = player.querySelector('[data-play-button]');
		const audioSrc = player.getAttribute('data-audio-src');
		const playerId = player.getAttribute('data-player-id');
		const visualization = player.getAttribute('data-visualization') === 'line' ? 'line' : 'dots';
		if (!(canvas instanceof HTMLCanvasElement) || !(button instanceof HTMLButtonElement) || !audioSrc) return;

		const context = canvas.getContext('2d');
		if (!context) return;

		let audio;
		let audioContext;
		let analyser;
		let source;
		let dataArray;
		let animationId;
		let isPlaying = false;
		let cssWidth = 560;
		let cssHeight = 72;
		const getLanguage = () =>
			document.documentElement.dataset.language === 'es' || document.documentElement.lang === 'es'
				? 'es'
				: 'en';
		const getControlLabel = (state) => {
			const language = getLanguage();
			if (state === 'pause') {
				return language === 'es'
					? player.getAttribute('data-pause-label-es') || 'Pausar preview'
					: player.getAttribute('data-pause-label-en') || 'Pause preview';
			}
			return language === 'es'
				? player.getAttribute('data-play-label-es') || 'Reproducir preview'
				: player.getAttribute('data-play-label-en') || 'Play preview';
		};
		const updateControlLabel = () => {
			button.setAttribute('aria-label', getControlLabel(isPlaying ? 'pause' : 'play'));
		};
		const signalOrange = getComputedStyle(document.documentElement).getPropertyValue('--signal-orange').trim() || '#FF5A1F';
		const signalOrangeRgb = signalOrange
			.replace('#', '')
			.match(/.{1,2}/g)
			?.map((value) => parseInt(value, 16))
			.join(', ') || '255, 90, 31';
		const signalOrangeAlpha = (alpha) => `rgba(${signalOrangeRgb}, ${alpha})`;

		const stopAnimation = () => {
			if (animationId) {
				cancelAnimationFrame(animationId);
				animationId = undefined;
			}
		};

		const drawIdle = () => {
			context.clearRect(0, 0, cssWidth, cssHeight);
			if (visualization === 'line') {
				const centerY = cssHeight / 2;
				context.beginPath();
				for (let x = 0; x <= cssWidth; x += 2) {
					const progress = x / Math.max(1, cssWidth);
					const envelope = Math.sin(progress * Math.PI);
					const y = centerY + Math.sin(progress * Math.PI * 12) * 2.4 * envelope;
					if (x === 0) context.moveTo(x, y);
					else context.lineTo(x, y);
				}
				context.strokeStyle = signalOrangeAlpha(0.68);
				context.lineWidth = 3.6;
				context.stroke();
				return;
			}
			const dots = 36;
			const centerY = cssHeight / 2;
			const usableWidth = Math.max(1, cssWidth - 8);

			for (let i = 0; i < dots; i += 1) {
				const progress = i / (dots - 1);
				const x = 4 + progress * usableWidth;
				const y = centerY + Math.sin(i * 0.62) * 9;
				context.beginPath();
				context.fillStyle = i % 3 === 0 ? signalOrangeAlpha(0.76) : 'rgba(223, 211, 187, 0.5)';
				context.arc(x, y, 2.6, 0, Math.PI * 2);
				context.fill();
			}
		};

		const resizeCanvas = () => {
			const rect = canvas.getBoundingClientRect();
			const ratio = window.devicePixelRatio || 1;
			cssWidth = visualization === 'line' ? Math.max(1, Math.floor(rect.width)) : Math.max(320, Math.floor(rect.width));
			cssHeight = 72;
			canvas.width = Math.floor(cssWidth * ratio);
			canvas.height = Math.floor(cssHeight * ratio);
			context.setTransform(ratio, 0, 0, ratio, 0, 0);

			if (isPlaying) {
				stopAnimation();
				render();
			} else {
				drawIdle();
			}
		};

		const resetToIdle = (resetTime = false) => {
			isPlaying = false;
			stopAnimation();
			if (audio) {
				if (!audio.paused) audio.pause();
				if (resetTime) audio.currentTime = 0;
			}
			button.innerHTML = playIcon;
			updateControlLabel();
			drawIdle();
		};

		const setupAudio = async () => {
			if (audio) return true;

			audio = new Audio(audioSrc);
			audio.crossOrigin = 'anonymous';
			audio.preload = 'none';
			audio.addEventListener('error', () => {
				resetToIdle(true);
			});
			audio.addEventListener('ended', () => {
				resetToIdle(true);
			});

			audioContext = new AudioContext();
			analyser = audioContext.createAnalyser();
			analyser.fftSize = 256;
			analyser.smoothingTimeConstant = 0.78;
			source = audioContext.createMediaElementSource(audio);
			source.connect(analyser);
			analyser.connect(audioContext.destination);
			dataArray = new Uint8Array(visualization === 'line' ? analyser.fftSize : analyser.frequencyBinCount);
			return true;
		};

		function render() {
			if (!isPlaying || !audio || audio.paused || audio.ended || !analyser || !dataArray) return;

			context.clearRect(0, 0, cssWidth, cssHeight);

			if (visualization === 'line') {
				analyser.getByteTimeDomainData(dataArray);
				const centerY = cssHeight / 2;
				const maxDisplacement = cssHeight * 0.46;
				const sliceWidth = cssWidth / Math.max(1, dataArray.length - 1);
				context.beginPath();
				dataArray.forEach((value, index) => {
					const amplitude = (value - 128) / 128;
					const x = index * sliceWidth;
					const displacement = Math.max(-maxDisplacement, Math.min(maxDisplacement, amplitude * cssHeight * 0.68));
					const y = centerY + displacement;
					if (index === 0) context.moveTo(x, y);
					else context.lineTo(x, y);
				});
				context.strokeStyle = signalOrangeAlpha(0.88);
				context.lineWidth = 4;
				context.stroke();
				animationId = requestAnimationFrame(render);
				return;
			}

			analyser.getByteFrequencyData(dataArray);

			const dotCount = 64;
			const centerY = cssHeight / 2;
			const usableWidth = Math.max(1, cssWidth - 8);
			const now = performance.now();
			const averageAmp =
				dataArray.reduce((total, value) => total + value, 0) / Math.max(1, dataArray.length) / 255;

			for (let i = 0; i < dotCount; i += 1) {
				const progress = i / (dotCount - 1);
				const dataIndex = Math.floor(progress * (dataArray.length - 1));
				const rawAmp = (dataArray[dataIndex] || 0) / 255;
				const amp = Math.max(rawAmp, averageAmp * 0.55);
				const x = 4 + progress * usableWidth;
				const y = centerY + Math.sin(now / 210 + i * 0.48) * (5 + amp * 22);
				const radius = 2.3 + amp * 5.4;

				context.beginPath();
				context.fillStyle = signalOrangeAlpha(0.48 + amp * 0.48);
				context.arc(x, y, radius, 0, Math.PI * 2);
				context.fill();
			}

			animationId = requestAnimationFrame(render);
		}

		window.addEventListener(stopEvent, (event) => {
			if (event.detail !== playerId) resetToIdle(true);
		});
		window.addEventListener('fhugawz:languagechange', updateControlLabel);

		button.addEventListener('click', async () => {
			await setupAudio();
			if (!audio || !audioContext) return;

			if (audioContext.state === 'suspended') await audioContext.resume();

			if (audio.paused) {
				window.dispatchEvent(new CustomEvent(stopEvent, { detail: playerId }));
				try {
					await audio.play();
					isPlaying = true;
					button.innerHTML = pauseIcon;
					updateControlLabel();
					stopAnimation();
					render();
				} catch {
					resetToIdle(true);
				}
			} else {
				resetToIdle();
			}
		});

		window.addEventListener('resize', resizeCanvas);
		resizeCanvas();
	});
</script>
