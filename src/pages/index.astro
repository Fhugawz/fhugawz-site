---
import Layout from '../layouts/Layout.astro';
import CurrentWorldFeature from '../components/home/CurrentWorldFeature.astro';
import WorldCatalogue from '../components/home/WorldCatalogue.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { artistUi } from '../data/artist-ui';
import { selectedJournalEntries } from '../data/journal';
import { publishedWorlds } from '../data/worlds';
import { localize, localizedAltAttributes, localizedTextAttributes } from '../utils/localization';

const currentWorld = publishedWorlds.find((world) => world.featured);
const [featuredEntry, ...secondaryEntries] = selectedJournalEntries;
if (!currentWorld || !featuredEntry) throw new Error('The artist homepage requires featured content.');
const heroLineOne = { en: 'One story told through', es: 'Una historia contada' };
const heroLineTwo = { en: 'thirteen worlds.', es: 'a través de trece mundos.' };
const heroEnter = { en: 'Enter the Worlds', es: 'Entrar a los mundos' };
const projectHeadline = {
	en: 'Narrative Music Universe',
	es: 'Universo musical narrativo',
};
const projectRotatingTitles = [
	projectHeadline,
	{ en: 'Where Memory Becomes Fiction', es: 'Donde la memoria se convierte en ficción' },
	{ en: 'One Story, Many Forms', es: 'Una historia, muchas formas' },
];
const projectSummary = {
	en: 'Fhugawz begins in autobiographical memory and gradually moves toward speculative fiction, horror, surrealism and transformation. Music, narrative and visual direction evolve together as one continuous work.',
	es: 'Fhugawz comienza en la memoria autobiográfica y avanza gradualmente hacia la ficción especulativa, el horror, el surrealismo y la transformación. Música, narrativa y dirección visual evolucionan como una sola obra continua.',
};
const projectNote = {
	en: '13 connected worlds · one continuous narrative work',
	es: '13 mundos conectados · una obra narrativa continua',
};
const journalLabel = { en: 'Journal', es: 'Journal' };
const journalTitle = { en: 'Inside the Work', es: 'Dentro del proceso' };
const journalDescription = {
	en: 'Notes from inside the work: process, evolution, experiments, references and the decisions shaping Fhugawz as it develops.',
	es: 'Notas desde dentro del proceso: evolución, experimentos, referencias y las decisiones que van dando forma a Fhugawz mientras el proyecto se desarrolla.',
};
const closingTitle = {
	en: 'Follow the Story as It Becomes Real',
	es: 'Sigue la historia mientras se vuelve real',
};
const closingDescription = {
	en: 'Follow the releases, trace the ideas behind them, or reach out directly to enter the world from another angle.',
	es: 'Sigue los lanzamientos, recorre las ideas detrás de ellos o escríbenos directamente para entrar al mundo desde otro ángulo.',
};
const jsonLd = { '@context': 'https://schema.org', '@type': 'MusicGroup', name: 'FHUGAWZ', url: 'https://fhugawz.com', description: artistUi.home.seo.description.en, image: 'https://fhugawz.com/images/hero/fhugawz-cinematic-dark-pop-hero.webp' };
---

<Layout title={artistUi.home.seo.title.en} spanishTitle={artistUi.home.seo.title.es} description={artistUi.home.seo.description.en} spanishDescription={artistUi.home.seo.description.es} image="/images/hero/fhugawz-cinematic-dark-pop-hero.webp" imageAlt={artistUi.home.hero.imageAlt.en} jsonLd={jsonLd}>
	<main class="cinematic-home">
		<section class="opening-frame" aria-labelledby="opening-title">
			<div class="opening-visual">
				<img class="opening-image" src="/images/hero/fhugawz-cinematic-dark-pop-hero.webp" alt={localize(artistUi.home.hero.imageAlt, 'en')} {...localizedAltAttributes(artistUi.home.hero.imageAlt)} fetchpriority="high" decoding="async" />
				<div class="opening-foreground" data-hero-foreground aria-hidden="true"></div>
			</div>
			<div class="opening-grade" aria-hidden="true"></div>
			<div class="site-shell opening-content">
				<div class="opening-copy">
					<div class="opening-meta">
						<span>01 / 13</span>
						<p {...localizedTextAttributes(artistUi.home.hero.kicker)}>{localize(artistUi.home.hero.kicker, 'en')}</p>
					</div>
					<h1 id="opening-title" class="opening-statement">
						<span {...localizedTextAttributes(heroLineOne)}>{localize(heroLineOne, 'en')}</span>
						<span {...localizedTextAttributes(heroLineTwo)}>{localize(heroLineTwo, 'en')}</span>
					</h1>
					<nav class="opening-actions" aria-label="Introduction">
						<a class="opening-primary" href="/worlds"><span {...localizedTextAttributes(heroEnter)}>{localize(heroEnter, 'en')}</span><span aria-hidden="true">↗</span></a>
						<a class="opening-listen" href="#selected-listening" {...localizedTextAttributes(artistUi.home.hero.listen)}>{localize(artistUi.home.hero.listen, 'en')}</a>
					</nav>
				</div>
			</div>
		</section>

		<section class="manifesto" aria-labelledby="manifesto-title">
			<video
				class="project-intro-background"
				data-project-intro-video
				autoplay
				muted
				loop
				playsinline
				disablepictureinpicture
				disableremoteplayback
				controlslist="nodownload nofullscreen noremoteplayback"
				tabindex="-1"
				preload="metadata"
				poster="/media/home/project/fhugawz-narrative-universe-night-city-poster.webp"
				aria-hidden="true"
			>
				<source src="/media/home/project/fhugawz-narrative-universe-night-city.mp4" type="video/mp4" />
			</video>
			<div class="project-intro-overlay" aria-hidden="true"></div>
			<div class="project-intro-inner">
				<div class="project-intro-marker" aria-hidden="true"><span></span></div>
				<p class="section-kicker" {...localizedTextAttributes(artistUi.home.project.kicker)}>{localize(artistUi.home.project.kicker, 'en')}</p>
				<h2 id="manifesto-title" class="project-intro-title" data-project-title-rotator>
					{projectRotatingTitles.map((title, index) => <span class:list={{ 'is-active': index === 0 }} {...localizedTextAttributes(title)}>{localize(title, 'en')}</span>)}
				</h2>
				<p class="project-intro-summary" {...localizedTextAttributes(projectSummary)}>{localize(projectSummary, 'en')}</p>
				<div class="project-intro-divider" aria-hidden="true"></div>
				<p class="project-intro-note" {...localizedTextAttributes(projectNote)}>{localize(projectNote, 'en')}</p>
			</div>
		</section>

		<CurrentWorldFeature world={currentWorld} />
		<WorldCatalogue worlds={publishedWorlds} />

		<section class="field-notes" aria-labelledby="journal-title">
			<div class="site-shell field-notes-head">
				<p class="field-notes-label" {...localizedTextAttributes(journalLabel)}>{localize(journalLabel, 'en')}</p>
				<h2 id="journal-title" {...localizedTextAttributes(journalTitle)}>{localize(journalTitle, 'en')}</h2>
				<p {...localizedTextAttributes(journalDescription)}>{localize(journalDescription, 'en')}</p>
			</div>
			<div class="site-shell field-notes-layout">
				<article class="featured-note"><a href={featuredEntry.href}><figure><img src={featuredEntry.image} alt={localize(featuredEntry.alt, 'en')} {...localizedAltAttributes(featuredEntry.alt)} loading="lazy" decoding="async" /><time class="featured-note-date" datetime={featuredEntry.date}>{featuredEntry.date}</time><div class="featured-note-copy"><p class="note-meta"><span {...localizedTextAttributes(featuredEntry.category)}>{localize(featuredEntry.category, 'en')}</span></p><h3 {...localizedTextAttributes(featuredEntry.title)}>{localize(featuredEntry.title, 'en')}</h3><p {...localizedTextAttributes(featuredEntry.excerpt)}>{localize(featuredEntry.excerpt, 'en')}</p></div></figure></a></article>
				<div class="secondary-notes">{secondaryEntries.map((entry) => <article><a href={entry.href}><img src={entry.image} alt={localize(entry.alt, 'en')} {...localizedAltAttributes(entry.alt)} loading="lazy" decoding="async" /><div><p class="note-meta"><span {...localizedTextAttributes(entry.category)}>{localize(entry.category, 'en')}</span><time datetime={entry.date}>{entry.date}</time></p><h3 {...localizedTextAttributes(entry.title)}>{localize(entry.title, 'en')}</h3></div></a></article>)}</div>
			</div>
		</section>

		<section class="authorship" aria-labelledby="creator-title">
			<div class="site-shell authorship-inner">
				<div class="authorship-image"><img src="/images/creator/jean-guevara-creator-direction.webp" alt={localize(artistUi.home.creator.imageAlt, 'en')} {...localizedAltAttributes(artistUi.home.creator.imageAlt)} loading="lazy" decoding="async" /></div>
				<div class="authorship-copy"><p class="section-kicker" {...localizedTextAttributes(artistUi.home.creator.kicker)}>{localize(artistUi.home.creator.kicker, 'en')}</p><h2 id="creator-title" {...localizedTextAttributes(artistUi.home.creator.title)}>{localize(artistUi.home.creator.title, 'en')}</h2><p class="creator-role" {...localizedTextAttributes(artistUi.home.creator.role)}>{localize(artistUi.home.creator.role, 'en')}</p><p {...localizedTextAttributes(artistUi.home.creator.description)}>{localize(artistUi.home.creator.description, 'en')}</p></div>
			</div>
		</section>

		<section class="final-signal" aria-labelledby="closing-title">
			<div class="site-shell final-signal-grid">
				<div class="final-signal-feature">
					<img src="/images/blog/building-an-independent-artist-world/building-independent-artist-world-release-strategy.webp" alt="" aria-hidden="true" loading="lazy" decoding="async" />
					<div class="final-signal-feature-copy"><p class="section-kicker" {...localizedTextAttributes(artistUi.home.closing.kicker)}>{localize(artistUi.home.closing.kicker, 'en')}</p><h2 id="closing-title" {...localizedTextAttributes(closingTitle)}>{localize(closingTitle, 'en')}</h2></div>
				</div>
				<div class="final-signal-copy"><p {...localizedTextAttributes(closingDescription)}>{localize(closingDescription, 'en')}</p><a class="contact-signal" href="/contact"><span {...localizedTextAttributes(artistUi.home.closing.contact)}>{localize(artistUi.home.closing.contact, 'en')}</span><span aria-hidden="true">↗</span></a><SocialLinks /></div>
			</div>
		</section>
	</main>
</Layout>

<script>
	import { gsap } from 'gsap';
	import { SplitText } from 'gsap/SplitText';

	gsap.registerPlugin(SplitText);

	const projectMotionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
	const projectVideo = document.querySelector('[data-project-intro-video]');
	const projectTitleRotator = document.querySelector('[data-project-title-rotator]');
	const projectTitles = projectTitleRotator ? Array.from(projectTitleRotator.querySelectorAll<HTMLElement>('span')) : [];
	let projectTitleIndex = 0;
	let projectTitleTimer = 0;
	let projectTitleRun = 0;
	let activeProjectSplit: SplitText | null = null;
	let activeProjectTitle: HTMLElement | null = null;
	let activeProjectTween: gsap.core.Tween | null = null;
	const projectTitleHoldDuration = 1800;

	const projectTitleText = (title) =>
		document.documentElement.dataset.language === 'es'
			? title.dataset.artistEs || ''
			: title.dataset.artistEn || '';

	const restoreProjectTitle = (title) => {
		title.textContent = projectTitleText(title);
		title.removeAttribute('aria-label');
		title.classList.remove('is-active');
	};

	const revertActiveProjectSplit = () => {
		activeProjectTween?.kill();
		activeProjectTween = null;
		if (activeProjectSplit) {
			gsap.killTweensOf(activeProjectSplit.chars);
			activeProjectSplit.revert();
		}
		activeProjectSplit = null;
		if (activeProjectTitle) {
			gsap.killTweensOf(activeProjectTitle);
			gsap.set(activeProjectTitle, { clearProps: 'opacity,transform' });
		}
		activeProjectTitle = null;
	};

	const stopProjectTitleRotation = () => {
		window.clearTimeout(projectTitleTimer);
		projectTitleTimer = 0;
		projectTitleRun += 1;
		projectTitleIndex = 0;
		revertActiveProjectSplit();
		projectTitles.forEach((title, index) => {
			gsap.killTweensOf(title);
			gsap.set(title, { clearProps: 'opacity,transform' });
			restoreProjectTitle(title);
			title.classList.toggle('is-active', index === 0);
		});
	};

	const enterProjectTitle = async (title, run) => {
		title.textContent = projectTitleText(title);
		title.classList.add('is-active');
		activeProjectTitle = title;
		activeProjectSplit = SplitText.create(title, {
			type: 'words,chars',
			smartWrap: true,
			wordsClass: 'split-word',
			charsClass: 'split-char',
		});
		activeProjectTween = gsap.fromTo(
			activeProjectSplit.chars,
			{ opacity: 0, y: 32 },
			{ opacity: 1, y: 0, duration: 0.75, ease: 'power3.out', stagger: 0.055, force3D: true }
		);
		await activeProjectTween.then();
		if (run !== projectTitleRun || projectMotionPreference.matches) return;
	};

	const rotateProjectTitle = async (run) => {
		if (run !== projectTitleRun || projectMotionPreference.matches) return;
		const current = projectTitles[projectTitleIndex];
		const nextIndex = (projectTitleIndex + 1) % projectTitles.length;
		const next = projectTitles[nextIndex];
		await gsap.to(current, { opacity: 0, y: -6, scale: 0.99, duration: 0.35, ease: 'power2.inOut', force3D: true });
		if (run !== projectTitleRun || projectMotionPreference.matches) return;
		current.classList.remove('is-active');
		revertActiveProjectSplit();
		projectTitleIndex = nextIndex;
		await enterProjectTitle(next, run);
		if (run === projectTitleRun && !projectMotionPreference.matches) {
			projectTitleTimer = window.setTimeout(() => void rotateProjectTitle(run), projectTitleHoldDuration);
		}
	};

	const startProjectTitleRotation = () => {
		if (projectMotionPreference.matches || projectTitles.length < 2 || projectTitleTimer) return;
		const run = projectTitleRun;
		projectTitleTimer = window.setTimeout(() => void rotateProjectTitle(run), 3500);
	};

	const syncProjectMotion = () => {
		if (projectMotionPreference.matches) {
			stopProjectTitleRotation();
			if (projectVideo instanceof HTMLVideoElement) projectVideo.pause();
			return;
		}
		startProjectTitleRotation();
		if (projectVideo instanceof HTMLVideoElement) projectVideo.play().catch(() => undefined);
	};

	const initializeProjectTitleMotion = async () => {
		if (document.fonts?.ready) await document.fonts.ready;
		if (!projectMotionPreference.matches && projectTitles[0]) await enterProjectTitle(projectTitles[0], projectTitleRun);
		syncProjectMotion();
	};

	void initializeProjectTitleMotion();
	projectMotionPreference.addEventListener('change', () => {
		stopProjectTitleRotation();
		if (!projectMotionPreference.matches && projectTitles[0]) void enterProjectTitle(projectTitles[0], projectTitleRun);
		syncProjectMotion();
	});
	window.addEventListener('fhugawz:languagechange', () => {
		if (projectMotionPreference.matches) return;
		stopProjectTitleRotation();
		if (projectTitles[0]) void enterProjectTitle(projectTitles[0], projectTitleRun);
		startProjectTitleRotation();
	});
</script>

<style>
	.cinematic-home{overflow:clip;background:#070a0c}.opening-frame{position:relative;display:flex;min-height:calc(100svh - 72px);align-items:flex-end;overflow:hidden;background:#070a0c}.opening-image,.opening-grade{position:absolute;inset:0;width:100%;height:100%}.opening-image{object-fit:cover;object-position:56% 42%;filter:saturate(.72) contrast(1.08);transform:scale(1.01)}.opening-grade{background:linear-gradient(90deg,rgba(4,7,9,.92) 0%,rgba(4,7,9,.67) 42%,rgba(4,7,9,.1) 82%),linear-gradient(0deg,#070a0c 0%,transparent 46%)}.opening-content{position:relative;z-index:1;width:100%;padding-top:18vh;padding-bottom:clamp(42px,7vh,76px)}.opening-content h1{width:min-content;margin:18px 0 0;font-family:var(--font-display);font-size:min(16.7vw,15rem);font-weight:900;letter-spacing:-.065em;line-height:.7;text-transform:uppercase}.opening-statement{max-width:760px;margin:clamp(42px,7vh,76px) 0 0;font-size:clamp(1.75rem,3vw,3.25rem);letter-spacing:-.025em;line-height:1.06}.opening-rail{display:grid;grid-template-columns:minmax(260px,1fr) auto;gap:40px;align-items:end;margin-top:clamp(42px,7vh,74px);padding-top:18px;border-top:1px solid rgba(244,240,231,.22)}.opening-rail>p{max-width:380px;margin:0;color:rgba(244,240,231,.58);font-size:.84rem}.opening-rail nav{display:flex;flex-wrap:wrap;gap:18px 36px;justify-content:flex-end}.opening-rail a,.text-signal{padding-bottom:5px;border-bottom:1px solid var(--signal-orange);font-size:.7rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;transition:color .25s ease,border-color .25s ease}.opening-rail a:hover,.opening-rail a:focus-visible,.text-signal:hover,.text-signal:focus-visible{color:var(--signal-orange)}.opening-index{position:absolute;right:20px;bottom:50%;z-index:1;color:rgba(244,240,231,.48);font-family:var(--font-display);font-size:.72rem;letter-spacing:.2em;writing-mode:vertical-rl}
	.manifesto{position:relative;padding:clamp(105px,15vw,220px) 0 clamp(88px,12vw,170px);background:#eee9de;color:#101417}.manifesto-ghost{position:absolute;top:-.08em;right:-.02em;color:rgba(16,20,23,.045);font-family:var(--font-display);font-size:clamp(18rem,47vw,48rem);font-weight:900;letter-spacing:-.1em;line-height:.8;pointer-events:none}.manifesto-grid{position:relative;display:grid;grid-template-columns:minmax(0,1.22fr) minmax(280px,.78fr);gap:clamp(50px,10vw,150px);align-items:end}.manifesto .section-kicker,.authorship .section-kicker{color:#9b3512}.manifesto h2{max-width:900px;margin:18px 0 0;font-family:var(--font-display);font-size:clamp(4rem,8.6vw,8.8rem);letter-spacing:-.055em;line-height:.83;text-transform:uppercase}.manifesto-copy{position:relative;max-width:560px;padding-left:28px;border-left:1px solid rgba(16,20,23,.24);font-size:clamp(1rem,1.35vw,1.18rem);line-height:1.72}.manifesto-copy p{margin:0}.manifesto-copy p+p{margin-top:24px;color:rgba(16,20,23,.62)}.process-line{position:relative;display:grid;grid-template-columns:repeat(4,1fr);margin-top:clamp(75px,11vw,140px);padding-left:0;list-style:none}.process-line li{display:flex;gap:16px;align-items:baseline;border-top:1px solid rgba(16,20,23,.24);padding:14px 20px 0 0}.process-line li:before{position:absolute;width:6px;height:6px;margin-top:-18px;border-radius:50%;content:'';background:#9b3512}.process-line span{color:#9b3512;font-family:var(--font-display);font-size:1.2rem}.process-line strong{font-size:.66rem;letter-spacing:.09em;text-transform:uppercase}
	.field-notes{padding:clamp(100px,13vw,180px) 0;background:#0e1317}.field-notes-head{display:flex;gap:32px;align-items:end;justify-content:space-between;margin-bottom:clamp(50px,7vw,86px)}.field-notes h2{margin:13px 0 0;font-family:var(--font-display);font-size:clamp(4.6rem,10vw,10rem);letter-spacing:-.06em;line-height:.75;text-transform:uppercase}.field-notes-layout{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(300px,.65fr);gap:clamp(40px,8vw,120px)}.featured-note a{display:block}.featured-note figure{aspect-ratio:16/9;margin:0;overflow:hidden}.featured-note img,.secondary-notes img{width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.2,.7,.2,1),filter .4s ease}.featured-note a:hover img,.secondary-notes a:hover img{transform:scale(1.025);filter:brightness(1.07)}.featured-note-copy{width:min(88%,720px);margin:-54px 0 0 auto;padding:28px 0 0 34px;background:#0e1317}.note-meta{display:flex;gap:15px;justify-content:space-between;margin:0;color:var(--signal-orange);font-size:.63rem;font-weight:800;letter-spacing:.11em;text-transform:uppercase}.note-meta time{color:rgba(244,240,231,.42)}.featured-note h3{margin:14px 0;font-family:var(--font-display);font-size:clamp(2.8rem,5vw,5.6rem);letter-spacing:-.045em;line-height:.87;text-transform:uppercase}.featured-note-copy>p:last-child{max-width:600px;margin:0;color:rgba(244,240,231,.6);line-height:1.55}.secondary-notes{display:flex;flex-direction:column;justify-content:flex-end}.secondary-notes article{padding:24px 0;border-top:1px solid rgba(244,240,231,.16)}.secondary-notes a{display:grid;grid-template-columns:112px 1fr;gap:22px;align-items:center}.secondary-notes img{aspect-ratio:1}.secondary-notes .note-meta{display:block}.secondary-notes .note-meta time{display:none}.secondary-notes h3{margin:12px 0 0;font-family:var(--font-display);font-size:clamp(1.55rem,2.5vw,2.5rem);line-height:.95;text-transform:uppercase}
	@media(max-width:900px){.manifesto-grid,.field-notes-layout{grid-template-columns:1fr}.manifesto-copy{max-width:660px;margin-left:22%}.field-notes-layout{gap:55px}.secondary-notes{display:grid;grid-template-columns:repeat(2,1fr);gap:28px}}
	@media(max-width:720px){.opening-frame{min-height:max(700px,calc(100svh - 64px))}.opening-image{object-position:64% center}.opening-grade{background:linear-gradient(0deg,#070a0c 0%,rgba(4,7,9,.7) 55%,rgba(4,7,9,.2) 100%),linear-gradient(90deg,rgba(4,7,9,.5),transparent)}.opening-content{padding-top:150px;padding-bottom:36px}.opening-content h1{width:100%;font-size:min(20vw,5.15rem);white-space:nowrap}.opening-statement{max-width:360px;margin-top:42px;font-size:clamp(1.55rem,7vw,2.05rem)}.opening-rail{grid-template-columns:1fr;gap:24px;margin-top:45px}.opening-rail nav{justify-content:flex-start}.opening-index{display:none}.manifesto{padding:100px 0 85px}.manifesto-ghost{top:.1em;font-size:75vw}.manifesto h2{font-size:clamp(3.55rem,17vw,5.2rem)}.manifesto-copy{margin-left:0;padding-left:20px}.process-line{grid-template-columns:repeat(2,1fr);gap:34px 0;margin-top:70px}.field-notes{padding:95px 0}.field-notes-head{align-items:start}.field-notes h2{font-size:min(20vw,6rem)}.featured-note-copy{width:95%;margin-top:-25px;padding:22px 0 0 20px}.secondary-notes{grid-template-columns:1fr;gap:0}}
	@media(max-width:480px){.opening-rail nav{flex-direction:column;align-items:flex-start;gap:20px}.field-notes-head{flex-direction:column;align-items:flex-start}.featured-note figure{aspect-ratio:4/5}.secondary-notes a{grid-template-columns:84px 1fr;gap:16px}.process-line strong{max-width:120px}}
	@media(prefers-reduced-motion:reduce){.opening-rail a,.text-signal,.featured-note img,.secondary-notes img{transition:none}}

	/* Opening-frame language: isolated here so the sections below retain their approved composition. */
	.opening-frame{min-height:100svh;align-items:stretch;background:#070807}
	.opening-visual,.opening-grade{position:absolute;inset:0;width:100%;height:100%}
	.opening-visual{overflow:hidden;background:#070807}
	.opening-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:58% 42%;filter:saturate(.7) contrast(1.08);transform:scale(1);transition:transform .7s cubic-bezier(.22,1,.36,1)}
	.opening-foreground{position:absolute;inset:0;z-index:1;pointer-events:none}
