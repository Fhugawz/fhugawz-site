---
import Layout from '../../layouts/Layout.astro';
import WorldArchiveDetail from '../../components/worlds/WorldArchiveDetail.astro';
import WorldArchiveGrid from '../../components/worlds/WorldArchiveGrid.astro';
import { artistUi } from '../../data/artist-ui';
import { publishedWorlds } from '../../data/worlds';
import { localize, localizedTextAttributes } from '../../utils/localization';

const heroWorld = publishedWorlds.find((world) => world.featured) ?? publishedWorlds[0];
const worldsHeroImage = '/images/hero/fhugawz-narrative-music-worlds-hero.webp';
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: artistUi.worldsPage.seoTitle.en,
	description: artistUi.worldsPage.seoDescription.en,
	url: 'https://fhugawz.com/worlds',
	hasPart: publishedWorlds.map((world) => ({
		'@type': 'CreativeWork',
		position: world.order,
		name: world.title,
		url: `https://fhugawz.com/worlds/${world.slug}`,
		description: world.summary.en,
	})),
};
---

<Layout
	title={artistUi.worldsPage.seoTitle.en}
	description={artistUi.worldsPage.seoDescription.en}
	spanishTitle={artistUi.worldsPage.seoTitle.es}
	spanishDescription={artistUi.worldsPage.seoDescription.es}
	image={worldsHeroImage}
	imageAlt="Fhugawz creating music in a dark home studio"
	jsonLd={jsonLd}
>
	<main class="world-archive">
		<section class="archive-opening" aria-labelledby="archive-title">
			<img src={worldsHeroImage} alt="" aria-hidden="true" />
			<div class="archive-opening-grade" aria-hidden="true"></div>
			<div class="site-shell archive-opening-copy">
				<div class="archive-opening-main">
					<p class="section-kicker" {...localizedTextAttributes(artistUi.worldsPage.kicker)}>{localize(artistUi.worldsPage.kicker, 'en')}</p>
					<h1 id="archive-title" {...localizedTextAttributes(artistUi.worldsPage.title)}>{localize(artistUi.worldsPage.title, 'en')}</h1>
					<p class="archive-opening-description" {...localizedTextAttributes(artistUi.worldsPage.description)}>{localize(artistUi.worldsPage.description, 'en')}</p>
				</div>
				<div class="archive-opening-note">
					<span aria-hidden="true">01—13</span>
					<p {...localizedTextAttributes(artistUi.worldsPage.archiveStatus)}>{localize(artistUi.worldsPage.archiveStatus, 'en')}</p>
				</div>
			</div>
		</section>

		<WorldArchiveGrid worlds={publishedWorlds} />
		<WorldArchiveDetail worlds={publishedWorlds} />
	</main>
</Layout>

<style>
	.world-archive{overflow:clip;background:#080a0b;color:#f1ede4}
	.archive-opening{position:relative;display:flex;min-height:calc(100svh - 72px);align-items:stretch;overflow:hidden;background:#080a0b}
	.archive-opening>img,.archive-opening-grade{position:absolute;inset:0;width:100%;height:100%}
	.archive-opening>img{object-fit:cover;object-position:center 42%;filter:saturate(.54) contrast(1.08) brightness(.66);transform:scale(1.01)}
	.archive-opening-grade{background:radial-gradient(circle at 62% 42%,rgba(7,9,10,.12),rgba(7,9,10,.58) 68%),linear-gradient(90deg,rgba(5,7,8,.9) 0%,rgba(5,7,8,.58) 50%,rgba(5,7,8,.22) 100%),linear-gradient(0deg,#080a0b 0%,rgba(8,10,11,.22) 58%,rgba(8,10,11,.5) 100%)}
	.archive-opening-copy{position:relative;z-index:1;display:flex;width:min(1160px,calc(100% - 40px));max-width:1160px;min-height:calc(100svh - 72px);flex-direction:column;justify-content:flex-end;padding-top:clamp(112px,15vh,168px);padding-right:0;padding-bottom:clamp(56px,8vh,88px);padding-left:0}
	.archive-opening-main{width:100%;max-width:560px}
	.archive-opening .section-kicker{margin:0;color:#a39f96;font-size:.7rem;font-weight:650;letter-spacing:.14em}
	.archive-opening h1{max-width:560px;margin:20px 0 0;font-family:var(--font-sans);font-size:clamp(1.875rem,2.8vw,2.875rem);font-weight:450;letter-spacing:-.025em;line-height:1.12;text-wrap:balance;text-transform:none}
	.archive-opening-description{max-width:540px;margin:clamp(26px,4vh,38px) 0 0;color:rgba(241,237,228,.68);font-size:clamp(.94rem,1.05vw,1rem);line-height:1.65;text-wrap:pretty}
	.archive-opening-note{position:relative;display:flex;width:100%;max-width:none;gap:28px;align-items:center;justify-content:space-between;margin-top:clamp(30px,4.5vh,44px);padding-top:16px;border-top:1px solid rgba(241,237,228,.2);color:rgba(241,237,228,.46);font-size:.64rem;font-weight:550;letter-spacing:.07em}
	.archive-opening-note::after{position:absolute;top:-2px;right:0;width:4px;height:4px;content:'';background:rgba(241,237,228,.88);transform:rotate(45deg)}
	.archive-opening-note span{color:rgba(255,90,31,.84)}
	.archive-opening-note p{margin:0;padding-right:12px;text-align:right}
	@media(max-width:700px){
		.archive-opening{min-height:calc(100svh - 64px)}
		.archive-opening>img{object-position:58% center}
		.archive-opening-grade{background:linear-gradient(180deg,rgba(7,9,10,.48),rgba(7,9,10,.38) 42%,#080a0b 100%)}
		.archive-opening-copy{width:100%;max-width:none;min-height:calc(100svh - 64px);padding-top:96px;padding-right:clamp(20px,6vw,24px);padding-bottom:42px;padding-left:clamp(20px,6vw,24px)}
		.archive-opening-main{max-width:340px}
		.archive-opening .section-kicker{font-size:.64rem;letter-spacing:.12em}
		.archive-opening h1{max-width:340px;margin-top:17px;font-size:clamp(1.875rem,8vw,2.25rem);font-weight:450;letter-spacing:-.025em;line-height:1.12}
		.archive-opening-description{max-width:340px;margin-top:24px;font-size:.94rem;line-height:1.62}
		.archive-opening-note{max-width:none;align-items:flex-start;flex-direction:column;gap:10px;margin-top:30px}
		.archive-opening-note p{text-align:left}
	}
</style>
