---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Artist Identity & Release Readiness Scorecard — Fhugawz Studio"
	description="A free bilingual diagnostic for independent artists to evaluate identity, sonic direction, visual world, release preparation and content systems."
	canonical="https://fhugawz.com/scorecard"
	spanishTitle="Diagnóstico de Identidad Artística y Preparación de Lanzamiento — Fhugawz Studio"
	spanishDescription="Un diagnóstico bilingüe gratuito para evaluar identidad, dirección sonora, universo visual, preparación de lanzamiento y sistema de contenido."
>
	<section class="scorecard-page" data-scorecard-app>
		<div class="scorecard-glow" aria-hidden="true"></div>
		<div class="site-shell scorecard-shell">
			<section class="scorecard-intro" data-scorecard-screen="intro">
				<p class="scorecard-kicker" data-scorecard-intro="kicker">FREE ARTIST DIAGNOSTIC</p>
				<h1 data-scorecard-intro="title">How ready is your artist world for the next release?</h1>
				<p class="scorecard-lede" data-scorecard-intro="body"></p>
				<div class="scorecard-meta">
					<span>20 questions</span><span>5 areas</span><span>5–8 min</span>
				</div>
				<p class="scorecard-privacy" data-scorecard-intro="privacy"></p>
				<button class="scorecard-button scorecard-button-primary" type="button" data-scorecard-start>
					START SCORECARD
				</button>
			</section>

			<section class="scorecard-panel" data-scorecard-screen="questions" hidden>
				<div class="scorecard-progress-header">
					<div>
						<p class="scorecard-kicker" data-scorecard-category-name></p>
						<p class="scorecard-category-description" data-scorecard-category-description></p>
					</div>
					<p class="scorecard-counter" data-scorecard-counter></p>
				</div>
				<div class="scorecard-progress" aria-hidden="true">
					<span data-scorecard-progress></span>
				</div>
				<form data-scorecard-form novalidate>
					<fieldset>
						<legend data-scorecard-question></legend>
						<div class="scorecard-options" data-scorecard-options></div>
					</fieldset>
					<p class="scorecard-error" data-scorecard-error role="alert" hidden></p>
					<div class="scorecard-actions">
						<button class="scorecard-button scorecard-button-secondary" type="button" data-scorecard-previous></button>
						<button class="scorecard-button scorecard-button-primary" type="submit" data-scorecard-next></button>
					</div>
				</form>
			</section>

			<section class="scorecard-results" data-scorecard-screen="results" aria-live="polite" hidden>
				<div class="scorecard-result-hero">
					<p class="scorecard-kicker" data-scorecard-result-label></p>
					<div class="scorecard-score"><strong data-scorecard-total></strong><span>/80</span></div>
					<h2 data-scorecard-result-title></h2>
					<p data-scorecard-result-diagnosis></p>
					<p class="scorecard-priority" data-scorecard-result-priority></p>
				</div>

				<div class="scorecard-result-grid">
					<section class="scorecard-result-card">
						<h3 data-scorecard-category-heading></h3>
						<div data-scorecard-category-results></div>
					</section>
					<section class="scorecard-result-card">
						<div class="scorecard-strength-row">
							<div><span data-scorecard-strongest-label></span><strong data-scorecard-strongest></strong></div>
							<div><span data-scorecard-weakest-label></span><strong data-scorecard-weakest></strong></div>
						</div>
						<h3 data-scorecard-next-steps-heading></h3>
						<ol data-scorecard-next-steps></ol>
					</section>
				</div>

				<section class="scorecard-recommendation">
					<p class="scorecard-kicker" data-scorecard-recommendation-heading></p>
					<p data-scorecard-recommendation></p>
					<a class="scorecard-button scorecard-button-primary" href="/services">EXPLORE FHUGAWZ STUDIO</a>
				</section>
				<button class="scorecard-button scorecard-button-secondary" type="button" data-scorecard-restart></button>
			</section>
		</div>
	</section>
</Layout>

<script src="../scripts/scorecard-app.js"></script>

<style>
	.scorecard-page { position: relative; min-height: 84vh; overflow: hidden; padding: clamp(72px, 10vw, 140px) 0; }
	.scorecard-glow { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(circle at 78% 15%, rgba(255,90,31,.18), transparent 34rem), radial-gradient(circle at 14% 58%, rgba(127,113,84,.22), transparent 30rem); }
	.scorecard-shell { position: relative; z-index: 1; }
	.scorecard-intro, .scorecard-panel, .scorecard-results { width: min(920px, 100%); margin: 0 auto; }
	.scorecard-intro { padding: clamp(32px, 6vw, 72px); border: 1px solid var(--line); background: rgba(13,16,13,.7); box-shadow: var(--shadow); backdrop-filter: blur(20px); }
	.scorecard-kicker { margin: 0 0 18px; color: var(--signal-orange); font-size: .72rem; font-weight: 800; letter-spacing: .2em; text-transform: uppercase; }
	.scorecard-intro h1, .scorecard-result-hero h2 { margin: 0; max-width: 850px; font-family: var(--font-display); font-size: clamp(3rem, 8vw, 7rem); font-weight: 900; letter-spacing: -.045em; line-height: .88; text-transform: uppercase; }
	.scorecard-lede, .scorecard-result-hero > p { max-width: 720px; margin: 28px 0 0; color: rgba(223,211,187,.76); font-size: clamp(1rem, 2vw, 1.22rem); line-height: 1.7; }
	.scorecard-meta { display: flex; flex-wrap: wrap; gap: 10px; margin: 30px 0 0; }
	.scorecard-meta span { padding: 8px 12px; border: 1px solid var(--line); border-radius: 999px; color: rgba(223,211,187,.68); font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; }
	.scorecard-privacy { margin: 24px 0 32px; color: rgba(223,211,187,.54); font-size: .85rem; line-height: 1.6; }
	.scorecard-button { display: inline-flex; min-height: 50px; align-items: center; justify-content: center; border: 1px solid transparent; padding: 13px 22px; cursor: pointer; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; transition: transform .2s ease, border-color .2s ease, background .2s ease; }
	.scorecard-button:hover { transform: translateY(-2px); }
	.scorecard-button:focus-visible, .scorecard-option:focus-within { outline: 3px solid color-mix(in srgb, var(--signal-orange) 68%, white); outline-offset: 3px; }
	.scorecard-button-primary { background: var(--signal-orange); color: #111; }
	.scorecard-button-secondary { border-color: var(--line); background: transparent; color: var(--bone); }
	.scorecard-panel, .scorecard-results { padding: clamp(24px, 5vw, 56px); border: 1px solid var(--line); background: rgba(13,16,13,.78); box-shadow: var(--shadow); backdrop-filter: blur(20px); }
	.scorecard-progress-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; }
	.scorecard-category-description, .scorecard-counter { margin: 0; color: rgba(223,211,187,.58); line-height: 1.5; }
	.scorecard-counter { flex: 0 0 auto; font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; }
	.scorecard-progress { height: 5px; margin: 24px 0 42px; overflow: hidden; background: rgba(223,211,187,.1); }
	.scorecard-progress span { display: block; width: 0; height: 100%; background: var(--signal-orange); transition: width .25s ease; }
	fieldset { min-width: 0; margin: 0; padding: 0; border: 0; }
	legend { max-width: 780px; margin-bottom: 28px; font-family: var(--font-display); font-size: clamp(2rem, 5vw, 4rem); font-weight: 900; letter-spacing: -.025em; line-height: 1; text-transform: uppercase; }
	.scorecard-options { display: grid; gap: 12px; }
	.scorecard-option { position: relative; display: grid; grid-template-columns: 36px 1fr; gap: 14px; align-items: start; padding: 16px; border: 1px solid var(--line); cursor: pointer; background: rgba(223,211,187,.025); transition: border-color .2s ease, background .2s ease; }
	.scorecard-option:hover, .scorecard-option:has(input:checked) { border-color: color-mix(in srgb, var(--signal-orange) 70%, transparent); background: rgba(255,90,31,.08); }
	.scorecard-option input { position: absolute; opacity: 0; }
	.scorecard-option-score { display: grid; width: 34px; height: 34px; place-items: center; border: 1px solid var(--line); border-radius: 50%; color: var(--signal-orange); font-weight: 900; }
	.scorecard-option strong { display: block; margin-bottom: 4px; }
	.scorecard-option small { color: rgba(223,211,187,.58); line-height: 1.45; }
	.scorecard-error { margin: 16px 0 0; color: #ff8d68; }
	.scorecard-actions { display: flex; justify-content: space-between; gap: 14px; margin-top: 32px; }
	.scorecard-result-hero { padding-bottom: 38px; border-bottom: 1px solid var(--line); }
	.scorecard-score { display: flex; align-items: baseline; gap: 6px; margin-bottom: 20px; color: var(--signal-orange); }
	.scorecard-score strong { font-family: var(--font-display); font-size: clamp(5rem, 13vw, 10rem); line-height: .8; }
	.scorecard-score span { font-size: 1.2rem; }
	.scorecard-priority { padding-left: 16px; border-left: 3px solid var(--signal-orange); color: var(--bone) !important; }
	.scorecard-result-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin: 24px 0; }
	.scorecard-result-card, .scorecard-recommendation { padding: 24px; border: 1px solid var(--line); background: rgba(223,211,187,.025); }
	.scorecard-result-card h3 { margin: 0 0 20px; font-family: var(--font-display); font-size: 1.65rem; text-transform: uppercase; }
	.scorecard-category-row { display: grid; grid-template-columns: 1fr auto; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); }
	.scorecard-category-row:last-child { border: 0; }
	.scorecard-strength-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 28px; }
	.scorecard-strength-row div { padding: 14px; border: 1px solid var(--line); }
	.scorecard-strength-row span, .scorecard-strength-row strong { display: block; }
	.scorecard-strength-row span { margin-bottom: 7px; color: rgba(223,211,187,.52); font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; }
	.scorecard-result-card ol { padding-left: 22px; color: rgba(223,211,187,.78); line-height: 1.65; }
	.scorecard-recommendation { margin-bottom: 18px; }
	.scorecard-recommendation > p:not(.scorecard-kicker) { max-width: 680px; color: rgba(223,211,187,.76); line-height: 1.65; }
	.scorecard-recommendation .scorecard-button { margin-top: 12px; }
	[hidden] { display: none !important; }
	@media (max-width: 720px) {
		.scorecard-page { padding-top: 50px; }
		.scorecard-intro, .scorecard-panel, .scorecard-results { padding: 24px 18px; }
		.scorecard-progress-header, .scorecard-actions { align-items: stretch; flex-direction: column; }
		.scorecard-result-grid, .scorecard-strength-row { grid-template-columns: 1fr; }
		.scorecard-actions .scorecard-button { width: 100%; }
	}
	@media (prefers-reduced-motion: reduce) { .scorecard-button, .scorecard-progress span { transition: none; } }
</style>
